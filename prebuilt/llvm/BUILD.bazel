load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("//prebuilt:platforms.bzl", "PLATFORMS")
load("//prebuilt/llvm:llvm_release.bzl", "exec_configured_file", "llvm_release")

llvm_release(name = "llvm_release")

llvm_release(
    name = "windows_llvm_release",
    bin_suffix = ".exe",
)

llvm_release(
    name = "windows_msvc_llvm_release",
    bin_suffix = ".exe",
    target_compatible_with = [
        "@platforms//os:windows",
        "//constraints/cxxstdlib:libcxx",
        "//constraints/windows/abi:msvc",
        "//constraints/windows/crt:ucrt",
    ],
)

[
    platform_transition_filegroup(
        name = "for_" + platform.split(":")[1],
        srcs = [
            ":windows_llvm_release" if "windows" in platform else ":llvm_release",
        ],
        target_platform = platform,
    )
    for platform in PLATFORMS
]

[
    platform_transition_filegroup(
        name = "for_windows_{}_msvc".format(archive_cpu),
        srcs = [":windows_msvc_llvm_release"],
        target_platform = "//platforms:windows_{}_msvc".format(target_cpu),
    )
    for archive_cpu, target_cpu in [
        ("amd64", "x86_64"),
        ("arm64", "aarch64"),
    ]
]

# Instrumented Stage 2 archives for FDO training on a host of each platform, see
# .github/workflows/llvm-prebuilt-pgo.yml. Stage 2 is only instrumented in an
# exec configuration, so it is built for the host as an execution platform:
# pass --extra_execution_platforms=<platform>.
_FDO_TRAINING_HOSTS = {
    "darwin-arm64": [
        "@platforms//cpu:aarch64",
        "@platforms//os:macos",
    ],
    "windows-amd64-msvc": [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        "//constraints/windows/abi:msvc",
    ],
}

[
    exec_configured_file(
        name = "instrumented_stage2_llvm_" + host,
        src = "//toolchain/bootstrap/stage2:llvm",
        exec_compatible_with = constraints,
        tags = ["manual"],
    )
    for host, constraints in _FDO_TRAINING_HOSTS.items()
]

[
    llvm_release(
        name = "instrumented_stage2_" + host,
        bin_suffix = ".exe" if host.startswith("windows") else "",
        llvm = ":instrumented_stage2_llvm_" + host,
    )
    for host in _FDO_TRAINING_HOSTS
]
