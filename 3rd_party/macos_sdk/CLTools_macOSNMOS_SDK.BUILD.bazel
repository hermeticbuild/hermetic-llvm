load("@llvm//:directory.bzl", "headers_directory")
load("@llvm//3rd_party/macos_sdk:sdk_headers.bzl", "macos_sdk_libcxx_headers")

headers_directory(
    name = "sysroot",
    path = ".",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "sysroot_without_libcxx_headers",
    srcs = glob(["**"], exclude = ["usr/include/c++/v1/**"]),
    visibility = ["//visibility:public"],
)

macos_sdk_libcxx_headers()
