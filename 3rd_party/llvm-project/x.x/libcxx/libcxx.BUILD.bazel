load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@llvm//3rd_party/llvm-project/21.x/libcxx:libcxx_headers.bzl", "LIBCXX_HEADERS_FILES_21")
load("@llvm//3rd_party/llvm-project/22.x/libcxx:libcxx_headers.bzl", "LIBCXX_HEADERS_FILES_22")
load("@llvm//3rd_party/llvm-project/23.x/libcxx:libcxx_headers.bzl", "LIBCXX_HEADERS_FILES_23")
load("@llvm//toolchain/runtimes:cc_runtime_shared_library.bzl", "cc_runtime_stage1_asan_shared_library")
load("@llvm//toolchain/runtimes:cc_runtime_static_library.bzl", "cc_runtime_stage0_asan_static_library", "cc_runtime_stage0_static_library")
load("@llvm-project//:vars.bzl", "LLVM_VERSION_MAJOR")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

# Should replicate libcxx/include/CMakeLists.txt
filegroup(
    name = "libcxx_21_headers_files",
    srcs = LIBCXX_HEADERS_FILES_21,
    visibility = ["//visibility:public"],
)

filegroup(
    name = "libcxx_22_headers_files",
    srcs = LIBCXX_HEADERS_FILES_22,
    visibility = ["//visibility:public"],
)

filegroup(
    name = "libcxx_23_headers_files",
    srcs = LIBCXX_HEADERS_FILES_23,
    visibility = ["//visibility:public"],
)

filegroup(
    name = "libcxx_headers_files",
    srcs = ([
        ":libcxx_23_headers_files",
    ] if int(LLVM_VERSION_MAJOR) >= 23 else [
        ":libcxx_22_headers_files",
    ] if int(LLVM_VERSION_MAJOR) >= 22 else [
        ":libcxx_21_headers_files",
    ]),
    visibility = ["//visibility:public"],
)

_CONFIG_SITE_MUSL_LINES = [
    "#define _LIBCPP_HAS_MUSL_LIBC 1",
]

_CONFIG_SITE_NO_MUSL_LINES = [
    "#define _LIBCPP_HAS_MUSL_LIBC 0",
]

_CONFIG_SITE_THREAD_API_WIN32_LINES = [
    "#define _LIBCPP_HAS_THREAD_API_PTHREAD 0",
    "#define _LIBCPP_HAS_THREAD_API_WIN32   1",
]

_CONFIG_SITE_THREAD_API_PTHREAD_LINES = [
    "#define _LIBCPP_HAS_THREAD_API_PTHREAD 1",
    "#define _LIBCPP_HAS_THREAD_API_WIN32   0",
]

_CONFIG_SITE_WINDOWS_MSVC_STATIC_LIBCXX_LINES = [
    "#define _LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS",
    # Bazel owns C++ runtime selection. Do not inject libc++.lib through
    # COFF .drectve sections emitted by every libc++ consumer object.
    "#define _LIBCPP_NO_AUTO_LINK",
]

_CONFIG_SITE_PREAMBLE_LINES = [
    "// Generated from this LLVM line's libcxx/include/__config_site.in.",
    "#ifndef _LIBCPP___CONFIG_SITE",
    "#define _LIBCPP___CONFIG_SITE",
]

_CONFIG_SITE_POSTAMBLE_LINES = [
    "#endif // _LIBCPP___CONFIG_SITE",
]

_CONFIG_SITE_ABI_MSVC_LINES = [
    "#define _LIBCPP_ABI_FORCE_ITANIUM       0",
    "#define _LIBCPP_ABI_FORCE_MICROSOFT     1",
    "#define _LIBCPP_HAS_TIME_ZONE_DATABASE  0",
]

_CONFIG_SITE_ABI_DEFAULT_LINES = [
    "#define _LIBCPP_ABI_FORCE_ITANIUM       0",
    "#define _LIBCPP_ABI_FORCE_MICROSOFT     0",
    "#define _LIBCPP_HAS_TIME_ZONE_DATABASE  1",
]

_CONFIG_SITE_LLVM_LINE_LINES = ([
    "// LLVM 23 libcxx/include/__config_site.in contract.",
    "#define _LIBCPP_HAS_THREAD_API_C11      0",
    "#define _LIBCPP_ASSERTION_SEMANTIC_DEFAULT 2",
    "#define _LIBCPP_LIBC_PICOLIBC 0",
    "#define _LIBCPP_LIBC_NEWLIB 0",
    "#define _LIBCPP_LIBC_LLVM_LIBC 0",
] if int(LLVM_VERSION_MAJOR) >= 23 else [
    "// LLVM 22 libcxx/include/__config_site.in contract.",
    "#define _LIBCPP_HAS_TERMINAL            1",
    "#define _LIBCPP_HAS_THREAD_API_C11      0",
    "#define _LIBCPP_ASSERTION_SEMANTIC_DEFAULT 2",
    "#define _LIBCPP_LIBC_PICOLIBC 0",
    "#define _LIBCPP_LIBC_NEWLIB 0",
] if int(LLVM_VERSION_MAJOR) >= 22 else [
    "// LLVM 21 libcxx/include/__config_site.in contract.",
    "#define _LIBCPP_HAS_TERMINAL            1",
    "#define _LIBCPP_HAS_THREAD_API_C11      0",
])

_CONFIG_SITE_GENERIC_LINES = [
    "#define _LIBCPP_ABI_VERSION             1",
    "#ifndef _LIBCPP_ABI_NAMESPACE",
    "#define _LIBCPP_ABI_NAMESPACE           __1",
    "#endif",
    "#define _LIBCPP_HAS_THREADS             1 // TODO: Handle no threads",
    "#define _LIBCPP_HAS_MONOTONIC_CLOCK     1",
    "#define _LIBCPP_HAS_THREAD_API_EXTERNAL 0",
    "// #define _LIBCPP_NO_VCRUNTIME",
    "// #define _LIBCPP_TYPEINFO_COMPARISON_IMPLEMENTATION @_LIBCPP_TYPEINFO_COMPARISON_IMPLEMENTATION@",
    "#define _LIBCPP_HAS_FILESYSTEM          1",
    "#define _LIBCPP_HAS_RANDOM_DEVICE       1",
    "#define _LIBCPP_HAS_LOCALIZATION        1",
    "#define _LIBCPP_HAS_UNICODE             1",
    "#define _LIBCPP_HAS_WIDE_CHARACTERS     1",
    "#define _LIBCPP_HAS_STD_MODULES         0",
    "#define _LIBCPP_HAS_VENDOR_AVAILABILITY_ANNOTATIONS 0",
    "#define _LIBCPP_INSTRUMENTED_WITH_ASAN  __has_feature(address_sanitizer)",
    "",
    "#define _LIBCPP_PSTL_BACKEND_SERIAL",
    "// #define _LIBCPP_PSTL_BACKEND_STD_THREAD",
    "// #define _LIBCPP_PSTL_BACKEND_LIBDISPATCH",
    "",
    "# // Hardening.",
    "#define _LIBCPP_HARDENING_MODE_DEFAULT _LIBCPP_HARDENING_MODE_NONE",
    "",
    "// \"_LIBCPP_HAS_NO_LIBRARY_ALIGNED_ALLOCATION\", # GLIBC < 2.16",
]

selects.config_setting_group(
    name = "windows_static",
    match_all = [
        "@platforms//os:windows",
        "@llvm//runtimes:linkmode_static",
    ],
)

selects.config_setting_group(
    name = "windows_msvc",
    match_all = [
        "@platforms//os:windows",
        "@llvm//constraints/windows/abi:msvc",
    ],
)

selects.config_setting_group(
    name = "windows_mingw",
    match_any = [
        "@llvm//platforms/config:windows_x86_64_mingw_compatible",
        "@llvm//platforms/config:windows_aarch64_mingw_compatible",
    ],
)

selects.config_setting_group(
    name = "windows_msvc_static_crt",
    match_all = [
        ":windows_msvc",
        "@llvm//toolchain/features/msvc:static_crt_config",
    ],
)

write_file(
    name = "__config_site",
    out = "include/__config_site",
    content = _CONFIG_SITE_PREAMBLE_LINES +
              _CONFIG_SITE_GENERIC_LINES +
              _CONFIG_SITE_LLVM_LINE_LINES +
              select({
                  ":windows_msvc": _CONFIG_SITE_ABI_MSVC_LINES,
                  "//conditions:default": _CONFIG_SITE_ABI_DEFAULT_LINES,
              }) +
              select({
                  # The supported Windows MSVC route is configuration-wide
                  # static libc++, including for ordinary /MD consumers.
                  # Public headers are configured outside the runtime build's
                  # linkmode transition, so encode that route contract here.
                  ":windows_msvc": _CONFIG_SITE_WINDOWS_MSVC_STATIC_LIBCXX_LINES,
                  "//conditions:default": [],
              }) +
              select({
                  "@llvm//constraints/libc:musl": _CONFIG_SITE_MUSL_LINES,
                  "//conditions:default": _CONFIG_SITE_NO_MUSL_LINES,
              }) +
              select({
                  "@platforms//os:windows": _CONFIG_SITE_THREAD_API_WIN32_LINES,
                  "//conditions:default": _CONFIG_SITE_THREAD_API_PTHREAD_LINES,
              }) +
              _CONFIG_SITE_POSTAMBLE_LINES,
    visibility = ["//visibility:public"],
)

copy_file(
    name = "__assertion_handler",
    src = "vendor/llvm/default_assertion_handler.in",
    out = "include/__assertion_handler",
    allow_symlink = True,
)

copy_to_directory(
    name = "libcxx_headers_include_search_directory",
    srcs = [
        ":__assertion_handler",
        ":__config_site",
    ] + [
        ":libcxx_headers_files",
    ],
    root_paths = [
        "libcxx/include",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "headers",
    hdrs = [
        ":__assertion_handler",
        ":__config_site",
        ":libcxx_headers_files",
    ],
    includes = [
        "generated_headers",
        "include",
        "src",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "textual_hdrs",
    srcs = glob([
        "src/**/*.h",
        "src/**/*.ipp",
    ]),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "libcxx",
    srcs = [
        # LIBCXX_SOURCES
        "src/algorithm.cpp",
        "src/any.cpp",
        "src/bind.cpp",
        "src/call_once.cpp",
        "src/charconv.cpp",
        "src/chrono.cpp",
        "src/error_category.cpp",
        "src/exception.cpp",
        "src/expected.cpp",
        "src/filesystem/filesystem_clock.cpp",
        "src/filesystem/filesystem_error.cpp",
        "src/filesystem/path_parser.h",
        "src/filesystem/path.cpp",
        "src/functional.cpp",
        "src/hash.cpp",
        "src/include/atomic_support.h",
        "src/include/config_elast.h",
        "src/include/refstring.h",
        "src/include/ryu/common.h",
        "src/include/ryu/d2fixed.h",
        "src/include/ryu/d2fixed_full_table.h",
        "src/include/ryu/d2s.h",
        "src/include/ryu/d2s_full_table.h",
        "src/include/ryu/d2s_intrinsics.h",
        "src/include/ryu/digit_table.h",
        "src/include/ryu/f2s.h",
        "src/include/ryu/ryu.h",
        "src/include/to_chars_floating_point.h",
        "src/include/from_chars_floating_point.h",
        "src/memory.cpp",
        "src/memory_resource.cpp",
        "src/new_handler.cpp",
        "src/new_helpers.cpp",
        "src/optional.cpp",
        "src/print.cpp",
        "src/random_shuffle.cpp",
        "src/ryu/d2fixed.cpp",
        "src/ryu/d2s.cpp",
        "src/ryu/f2s.cpp",
        "src/stdexcept.cpp",
        "src/string.cpp",
        "src/support/runtime/exception_fallback.ipp",
        "src/support/runtime/exception_glibcxx.ipp",
        "src/support/runtime/exception_libcxxabi.ipp",
        "src/support/runtime/exception_libcxxrt.ipp",
        "src/support/runtime/exception_msvc.ipp",
        "src/support/runtime/exception_pointer_cxxabi.ipp",
        "src/support/runtime/exception_pointer_glibcxx.ipp",
        "src/support/runtime/exception_pointer_msvc.ipp",
        "src/support/runtime/exception_pointer_unimplemented.ipp",
        "src/support/runtime/stdexcept_default.ipp",
        "src/support/runtime/stdexcept_vcruntime.ipp",
        "src/system_error.cpp",
        "src/typeinfo.cpp",
        "src/valarray.cpp",
        "src/variant.cpp",
        "src/vector.cpp",
        "src/verbose_abort.cpp",
    ] + ([
        "src/include/apple_availability.h",
    ] if int(LLVM_VERSION_MAJOR) < 23 else []) + [
        # LIBCXX_ENABLE_THREADS
        "src/atomic.cpp",
        "src/barrier.cpp",
        "src/condition_variable_destructor.cpp",
        "src/condition_variable.cpp",
        "src/future.cpp",
        "src/mutex_destructor.cpp",
        "src/mutex.cpp",
        "src/shared_mutex.cpp",
        "src/thread.cpp",
    ] + [
        # LIBCXX_ENABLE_RANDOM_DEVICE
        "src/random.cpp",
    ] + select({
        "@platforms//os:windows": [
            "src/support/win32/compiler_rt_shims.cpp",
            "src/support/win32/locale_win32.cpp",
            "src/support/win32/support.cpp",
            "src/support/win32/thread_win32.cpp",
        ],
        "//conditions:default": [],
    }) + [
        # LIBCXX_ENABLE_LOCALIZATION
        "src/fstream.cpp",
        "src/include/sso_allocator.h",
        "src/ios.cpp",
        "src/ios.instantiations.cpp",
        "src/iostream.cpp",
        "src/locale.cpp",
        "src/ostream.cpp",
        "src/regex.cpp",
        "src/strstream.cpp",
    ] + ([
        "src/text_encoding.cpp",
    ] if int(LLVM_VERSION_MAJOR) >= 23 else []) + [
        # LIBCXX_ENABLE_FILESYSTEM
        "src/filesystem/directory_entry.cpp",
        "src/filesystem/directory_iterator.cpp",
        "src/filesystem/file_descriptor.h",
        "src/filesystem/operations.cpp",
        "src/filesystem/posix_compat.h",
        "src/filesystem/time_utils.h",
        # NOT LIBCXX_USE_COMPILER_RT
        # omit int128_builtins.cpp because it provides __muloti4 which is already provided
        # by llvm compiler_rt.
        # "src/filesystem/int128_builtins.cpp",
    ] + [
        # LIBCXX_ENABLE_NEW_DELETE_DEFINITIONS
    ],
    hdrs = [
        ":__assertion_handler",
        ":__config_site",
        ":libcxx_headers_files",
    ],
    copts = select({
        ":windows_msvc": [
            "/clang:-faligned-allocation",
            "/std:c++latest",

            # Compiler-agnostic warnings to disable.
            "/clang:-Wno-unused-parameter",
            "/clang:-Wno-long-long",
            "/clang:-Wno-nullability-completeness",

            # Clang-specific warnings to disable.
            "/clang:-Wno-user-defined-literals",
            "/clang:-Wno-covered-switch-default",
            "/clang:-Wno-suggest-override",
            "/clang:-Wno-macro-redefined",
        ],
        "//conditions:default": [
            "-faligned-allocation",
            "-std=c++26" if int(LLVM_VERSION_MAJOR) >= 23 else "-std=c++23",
            "-fvisibility=hidden",
            "-fvisibility-inlines-hidden",

            # Compiler-agnostic warnings to disable.
            "-Wno-unused-parameter",
            "-Wno-long-long",
            "-Wno-nullability-completeness",

            # Clang-specific warnings to disable.
            "-Wno-user-defined-literals",
            "-Wno-covered-switch-default",
            "-Wno-suggest-override",
        ],
    }) + select({
        ":windows_msvc": [
            "/clang:-Wno-pragma-pack",
            "/clang:-Wno-unused-value",
        ],
        ":windows_mingw": [
            "-Wno-pragma-pack",
            "-Wno-unused-value",
        ],
        "//conditions:default": [],
    }) + select({
        # clang-cl's /MD and /MT defaults do not name the Microsoft C++
        # exception_ptr provider. Make libc++'s archive own that narrow ABI
        # dependency through a COFF .drectve instead of a Bazel link argument.
        ":windows_msvc_static_crt": [
            "/clang:-Xclang",
            "/clang:--dependent-lib=libcpmt",
        ],
        ":windows_msvc": [
            "/clang:-Xclang",
            "/clang:--dependent-lib=msvcprt",
        ],
        "//conditions:default": [],
    }),
    features = select({
        # The MSVC link names libc++.lib through /DEFAULTLIB and its declared
        # library search directory, not as a LibraryToLink in rules_cc's
        # per-object ThinLTO graph. Keep libc++ itself as native COFF so the
        # linker can consume the opaque archive directly; consumer objects
        # still use ThinLTO. Including libc++ in ThinLTO would first require
        # modeling its members and backend actions in that graph.
        ":windows_msvc": ["-thin_lto"],
        "//conditions:default": [],
    }),
    implementation_deps = [
        # Order matter. Search path should have C++ headers before any lib C headers.
        "@llvm-project//libcxx:headers",
    ] + select({
        ":windows_msvc": [],
        "//conditions:default": ["@llvm-project//libcxxabi:headers"],
    }) + select({
        "@platforms//os:macos": [],
        "@platforms//os:windows": [],
        "@platforms//os:linux": [
            # TODO(cerisier): Provide only a subset of linux UAPI headers for musl.
            # https://github.com/hermeticbuild/hermetic-llvm/issues/146
            "@kernel_headers",
        ],
    }) + [
        # libcxx depends on a set of internal llvm-libc headers. (libc/shared)
        # See project hand-in-hand.
        # https://discourse.llvm.org/t/rfc-project-hand-in-hand-llvm-libc-libc-code-sharing/77701
        "@llvm-project//libc:libc_headers",
    ] + select({
        "@llvm//platforms/config:musl": [
            "@musl_libc//:musl_libc_headers",
        ],
        "@llvm//platforms/config:gnu": [
            "@glibc//:gnu_libc_headers",
        ],
        "@platforms//os:windows": [],
        "@platforms//os:macos": [],
    }) + select({
        ":windows_msvc": [],
        "@llvm//platforms/config:windows_x86_64_mingw_compatible": [
            "@mingw//:mingw_headers",
        ],
        "@llvm//platforms/config:windows_aarch64_mingw_compatible": [
            "@mingw//:mingw_headers",
        ],
        "//conditions:default": [],
    }),
    includes = [
        "include",
        "src",
    ],
    # The MSVC route exposes only the purpose-built static libc++ archive.
    # Generic routes retain the cc_library default so the shared-runtime rule
    # can preserve the pre-MSVC implementation graph.
    linkstatic = select({
        ":windows_msvc": True,
        "//conditions:default": False,
    }),
    local_defines = [
        "LIBC_NAMESPACE=__llvm_libc_common_utils",
        "_LIBCPP_BUILDING_LIBRARY",
        "_LIBCPP_REMOVE_TRANSITIVE_INCLUDES",
        "_LIBCPP_HAS_NO_PRAGMA_SYSTEM_HEADER",
    ] + select({
        "@llvm//config:runtimes_optimization_mode_debug": [],
        "//conditions:default": ["NDEBUG"],
    }) + select({
        ":windows_msvc": [
            "_ALLOW_ITERATOR_DEBUG_LEVEL_MISMATCH",
            "_ALLOW_MSC_VER_MISMATCH",
            "_CRTBLD",
            "_CRT_NONSTDC_NO_WARNINGS",
            "_CRT_SECURE_NO_WARNINGS",
            "_CRT_STDIO_ISO_WIDE_SPECIFIERS",
        ],
        # The Itanium route builds libc++ against libc++abi. Defining this on
        # the VCRuntime route makes LLVM 21's exception.cpp include cxxabi.h
        # and would select the wrong ABI implementation.
        "//conditions:default": ["LIBCXX_BUILDING_LIBCXXABI"],
    }) + select({
        ":windows_static": ["_LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS"],
        "//conditions:default": [],
    }),
    textual_hdrs = glob([
        "src/**/*.h",
        "src/**/*.ipp",
    ]) + select({
        ":windows_msvc": [],
        "//conditions:default": ["@llvm-project//libcxxabi:textual_hdrs"],
    }),
    visibility = ["//compiler-rt:__pkg__"],
)

cc_runtime_stage0_asan_static_library(
    # The generic Stage 0 route inherits the configured ASan runtime policy.
    name = "libcxx.static.stage0_asan_inheriting",
    visibility = ["//visibility:public"],
    deps = [
        ":libcxx",
    ],
)

cc_runtime_stage0_static_library(
    # The Windows MSVC route deliberately does not inherit ASan. It is the
    # static libc++ input to the ordinary complete consumer toolchain.
    name = "libcxx.static.stage0_non_asan",
    visibility = ["//visibility:public"],
    deps = [
        ":libcxx",
    ],
)

copy_file(
    # The explicit clang-cl C++ runtime link contract names libc++.lib.
    name = "libcxx.static.msvc_link_name",
    src = ":libcxx.static.stage0_non_asan",
    out = "libc++.lib",
    allow_symlink = True,
    visibility = ["//visibility:public"],
)

cc_runtime_stage1_asan_shared_library(
    name = "libcxx.shared.default",
    shared_lib_name = "libc++.so.1",
    user_link_flags = [
        "-Wl,-soname,libc++.so.1",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":libcxx",
    ],
)

filegroup(
    name = "libcxx.shared.msvc.unsupported",
    srcs = [],
    target_compatible_with = ["@platforms//:incompatible"],
    visibility = ["//visibility:public"],
)

alias(
    name = "libcxx.static",
    actual = select({
        ":windows_msvc": ":libcxx.static.msvc_link_name",
        "//conditions:default": ":libcxx.static.stage0_asan_inheriting",
    }),
    visibility = ["//visibility:public"],
)

alias(
    name = "libcxx.shared",
    actual = select({
        ":windows_msvc": ":libcxx.shared.msvc.unsupported",
        "//conditions:default": ":libcxx.shared.default",
    }),
    visibility = ["//visibility:public"],
)
