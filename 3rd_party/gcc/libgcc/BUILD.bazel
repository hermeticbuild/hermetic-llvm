load("@bazel_lib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

bzl_library(
    name = "configure_ac",
    srcs = ["configure.ac.bzl"],
    deps = [
        "//3rd_party/gcc:gcc_config_checks",
        "//3rd_party/gcc/autoconf:checks",
    ],
)

bzl_library(
    name = "makefile",
    srcs = ["makefile.bzl"],
)

bzl_library(
    name = "target_config",
    srcs = ["target_config.bzl"],
)

bzl_library(
    name = "libgcc_rules",
    srcs = ["libgcc_rules.bzl"],
    deps = [
        "@rules_cc//cc:action_names_bzl",
        "@rules_cc//cc:find_cc_toolchain_bzl",
        "@rules_cc//cc/common",
    ],
)
