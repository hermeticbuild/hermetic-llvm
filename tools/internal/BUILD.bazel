load("@bazel_lib//lib:transitions.bzl", "platform_transition_binary")
load("//platforms:common.bzl", "SUPPORTED_EXECS")
load("//toolchain/runtimes:cc_runtime_binary.bzl", "cc_runtime_stage1_hosted_binary")

cc_runtime_stage1_hosted_binary(
    name = "header-parser",
    srcs = ["header_parser.c"],
    visibility = ["//visibility:public"],
)

cc_runtime_stage1_hosted_binary(
    name = "native/module-map-generator",
    srcs = ["module_map_generator.c"],
)

# The generator runs on the execution platform before Clang can consume the
# module map. Linux workers need not provide a glibc loader.
_LINUX_CPUS = [cpu for os, cpu in SUPPORTED_EXECS if os == "linux"]

[
    platform_transition_binary(
        name = "module-map-generator-" + cpu,
        binary = ":native/module-map-generator",
        target_compatible_with = [
            "@platforms//os:linux",
            "@platforms//cpu:" + cpu,
        ],
        target_platform = "//platforms:linux_{}_musl".format(cpu),
    )
    for cpu in _LINUX_CPUS
]

alias(
    name = "module-map-generator",
    actual = select({
        "//platforms/config:linux_" + cpu: ":module-map-generator-" + cpu
        for cpu in _LINUX_CPUS
    } | {"//conditions:default": ":native/module-map-generator"}),
    visibility = ["//visibility:public"],
)

cc_runtime_stage1_hosted_binary(
    name = "static-library-validator",
    srcs = ["static_library_validator.c"],
    visibility = ["//visibility:public"],
)

# rustc infers the linker flavor from the executable name. Keep the `-clang++`
# suffix so Rust shared-library links treat this wrapper as a compiler driver.
cc_runtime_stage1_hosted_binary(
    name = "link-wrapper-clang++",
    srcs = ["link_wrapper.c"],
    features = ["-generate_dsym_file"],
    visibility = ["//tools/internal:__pkg__"],
)

alias(
    name = "link-wrapper",
    actual = ":link-wrapper-clang++",
    visibility = ["//visibility:public"],
)
