load("@bazel_lib//:bzl_library.bzl", "bzl_library")
load(":declare_toolchains.bzl", "declare_toolchain_registrations")

exports_files(["zstd-fdo-wasi-chown.patch"])

# The bootstrap stage toolchains stay out of //toolchain:all. Builds that select
# a bootstrap stage register this package too, see --config=release.
declare_toolchain_registrations()

bzl_library(
    name = "bootstrap_binary",
    srcs = ["bootstrap_binary.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        ":transition_settings",
        "//tools:defs",
        "@bazel_lib//lib:copy_file",
        "@bazel_lib//lib:copy_to_directory",
        "@bazel_skylib//lib:paths",
        "@bazel_skylib//rules/directory:providers",
    ],
)

bzl_library(
    name = "fdo_profile",
    srcs = ["fdo_profile.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        ":transition_settings",
        "@rules_cc//cc:action_names_bzl",
        "@rules_cc//cc:find_cc_toolchain_bzl",
        "@rules_cc//cc/common",
        "@rules_cc//cc/private/rules_impl/fdo:srcs",
    ],
)

bzl_library(
    name = "transition_settings",
    srcs = ["transition_settings.bzl"],
    visibility = ["//visibility:public"],
    deps = ["@llvm_version//:version"],
)

bzl_library(
    name = "declare_toolchains",
    srcs = ["declare_toolchains.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        ":bootstrap_binary",
        "//platforms:common",
        "//toolchain:cc_toolchain",
        "//toolchain:merged_resource_directory",
        "//toolchain/args:resource_directory_args",
        "//toolchain/llvm:component_tools",
        "@bazel_skylib//rules/directory:subdirectory",
        "@llvm_version//:version",
        "@rules_cc//cc/toolchains:toolchain_rules",
    ],
)
