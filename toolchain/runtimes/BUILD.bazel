load("@bazel_lib//:bzl_library.bzl", "bzl_library")
load("@rules_cc//cc/toolchains/impl:documented_api.bzl", "cc_args_list")

# gazelle:exclude cc_unsanitized_library.bzl

cc_args_list(
    name = "hermetic_link_flags",
    args = select({
        # The generic -nostdlib++ policy says that Bazel's runtime attributes
        # own C++ runtime linkage. /NODEFAULTLIB is not its clang-cl equivalent:
        # it would also suppress the selected Microsoft CRT and SDK libraries.
        # The complete MSVC toolchain instead disables libc++ object auto-link
        # metadata and names static libc++ through its default-libraries
        # composition.
        "//constraints/windows/abi:msvc": [],
        "@platforms//os:macos": [],
        "//conditions:default": [
            "//toolchain/runtimes/args:hermetic_link_flags",
        ],
    }),
)

cc_args_list(
    name = "default_link_flags",
    args = select({
        "@platforms//os:macos": [
            "//toolchain/args/macos:default_link_flags",
        ],
        "@platforms//os:windows": ["//toolchain/args/windows:default_link_flags"],
        "//conditions:default": [],
    }),
)

cc_args_list(
    name = "linux_hosted_c_toolchain_args",
    args = select({
        "//platforms/config:musl": [
            "//toolchain/args/linux:kernel_headers_include_search_paths",
            "//toolchain/args/linux:musl_libc_headers_include_search_paths",
        ],
        "//platforms/config:gnu": [
            "//toolchain/args/linux:kernel_headers_include_search_paths",
            "//toolchain/args/linux:glibc_headers_include_search_paths",
        ],
        "//conditions:default": [],
    }) + select({
        "//platforms/config:musl": [
            # TODO: Handle musl dynamic linking.
            # musl implies static linking for now.
            "//toolchain/args:static_link_executable",
        ],
        "//conditions:default": [],
    }) + [
        "//toolchain/args/linux:sanitizer_headers_include_search_paths",
    ],
    visibility = ["//toolchain:__subpackages__"],
)

cc_args_list(
    name = "stage1_hosted_platform_specific_args",
    args = select({
        "@platforms//os:macos": [
            "//toolchain:macos_toolchain_args",
        ],
        "@platforms//os:linux": [
            ":linux_hosted_c_toolchain_args",
        ],
        # Windows uses the complete :windows_toolchain_args composition below.
        "@platforms//os:windows": [],
        "@platforms//os:none": [],
    }),
    visibility = ["//toolchain:__subpackages__"],
)

cc_args_list(
    name = "platform_specific_args",
    args = select({
        "@platforms//os:macos": [
            "//toolchain:macos_toolchain_args",
        ],
        "@platforms//os:linux": [],
        # Windows uses the complete :windows_toolchain_args composition below.
        "@platforms//os:windows": [],
        "@platforms//os:none": [],
    }),
    visibility = ["//toolchain:__subpackages__"],
)

cc_args_list(
    name = "staged_platform_specific_args",
    args = select({
        "//toolchain:runtimes_stage1_hosted": [
            ":stage1_hosted_platform_specific_args",
        ],
        "//conditions:default": [
            ":platform_specific_args",
        ],
    }),
    visibility = ["//toolchain:__subpackages__"],
)

cc_args_list(
    name = "generic_toolchain_args",
    args = [
        # Common default compile flags.
        "//toolchain/args:target_flags",
        "//toolchain/args:no_absolute_paths_for_builtins",
        "//toolchain/args:deterministic_compile_flags",
        "//toolchain/args:module_map",
        "//toolchain/runtimes/args:optimization_flags",
        "//toolchain:sysroot_flags",
        "//toolchain:hermetic_compile_flags",
        ":hermetic_link_flags",

        # Keep external -isystem directories before the toolchain C
        # -isystem directories in :staged_platform_specific_args.
        "@rules_cc//cc/toolchains/args/external_include_paths:external_include_paths",

        # TODO(cerisier): Explode this into specific args instead
        ":staged_platform_specific_args",

        # Optional sanitizers
        "//toolchain/runtimes/args:ubsan_flags",
        "//toolchain/runtimes/args:cfi_flags",
        "//toolchain/runtimes/args:msan_flags",
        "//toolchain/runtimes/args:dfsan_flags",
        "//toolchain/runtimes/args:nsan_flags",
        "//toolchain/runtimes/args:safestack_flags",
        "//toolchain/runtimes/args:rtsan_flags",
        "//toolchain/runtimes/args:tysan_flags",
        "//toolchain/runtimes/args:tsan_flags",
        "//toolchain/runtimes/args:asan_flags",
        "//toolchain/runtimes/args:lsan_flags",
        "//toolchain/runtimes/args:profile_flags",

        # Common default link flags.
        "//toolchain:deterministic_link_flags",
        "//toolchain/args:fuse_ld",
        "//toolchain/args:lto_plugin_target_flags",
        ":rtlib",
        ":default_link_flags",
        # Needs to stay out of resource_dir since clang does not always search for crtstuff for all targets.
        ":default_startfiles",
        ":default_libs",
        # TODO: rules_cc passes extra args to these actions, ideally these would be fixed in rules_cc.
        "//toolchain/args:ignore_unused_command_line_argument",
    ],
)

cc_args_list(
    name = "windows_headers_before_compiler_resource",
    args = select({
        "//toolchain:runtimes_stage1_hosted": ["//toolchain/args/windows:headers_before_compiler_resource"],
        "//conditions:default": [],
    }),
)

# Keep the complete Windows runtime composition explicit while its individual
# compiler-personality, object-format, ABI, and runtime semantics are being
# normalized. This mirrors :generic_toolchain_args instead of appending a bag
# of Windows-only arguments through :staged_platform_specific_args.
cc_args_list(
    name = "windows_toolchain_args",
    args = [
        # Common default compile flags.
        "//toolchain/args/windows:target_flags",
        "//toolchain/args:no_absolute_paths_for_builtins",
        "//toolchain/args/windows:deterministic_compile_flags",
        "//toolchain/args:module_map",
        "//toolchain/runtimes/args:optimization_flags",
        "//toolchain:sysroot_flags",
        "//toolchain:hermetic_compile_flags",
        ":hermetic_link_flags",

        # Keep external -isystem directories before the toolchain C and C++
        # -isystem directories below.
        "@rules_cc//cc/toolchains/args/external_include_paths:external_include_paths",

        # Windows compiler, ABI, CRT, object-format, and C++ runtime semantics.
        "//toolchain/args/windows:crt_compile_defines",
        ":windows_headers_before_compiler_resource",

        # Optional sanitizers
        "//toolchain/runtimes/args:ubsan_flags",
        "//toolchain/runtimes/args:cfi_flags",
        "//toolchain/runtimes/args:msan_flags",
        "//toolchain/runtimes/args:dfsan_flags",
        "//toolchain/runtimes/args:nsan_flags",
        "//toolchain/runtimes/args:safestack_flags",
        "//toolchain/runtimes/args:rtsan_flags",
        "//toolchain/runtimes/args:tysan_flags",
        "//toolchain/runtimes/args:tsan_flags",
        "//toolchain/runtimes/args:asan_flags",
        "//toolchain/runtimes/args:lsan_flags",
        "//toolchain/runtimes/args:profile_flags",

        # Common default link flags.
        "//toolchain:deterministic_link_flags",
        "//toolchain/args:fuse_ld",
        "//toolchain/args:lto_plugin_target_flags",
        ":rtlib",
        ":default_link_flags",
        # Needs to stay out of resource_dir since clang does not always search for crtstuff for all targets.
        ":default_startfiles",
        ":default_libs",
        "//toolchain/args/windows:configuration_validation_args",
        "//toolchain/args/windows:crt_linkage_args",
        "//toolchain/args/windows:ignore_unused_command_line_argument",
    ],
)

cc_args_list(
    name = "toolchain_args",
    args = select({
        "@platforms//os:windows": [":windows_toolchain_args"],
        "//conditions:default": [":generic_toolchain_args"],
    }),
    visibility = ["//visibility:public"],
)

