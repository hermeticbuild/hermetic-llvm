load("@bazel_lib//:bzl_library.bzl", "bzl_library")
load("@rules_cc//cc/toolchains/impl:documented_api.bzl", "cc_args_list")
load(":toolchain_args.bzl", "runtime_toolchain_args")

# gazelle:exclude cc_unsanitized_library.bzl

cc_args_list(
    name = "linker",
    # Intermediate runtime links use LLD even for component targets. Component
    # assembly belongs to the complete application toolchain.
    args = ["//toolchain/args:fuse_lld"],
)

cc_args_list(
    name = "default_link_flags",
    args = select({
        "@platforms//os:macos": [
            "//toolchain/args/macos:default_link_flags",
        ],
        "@platforms//os:windows": ["//toolchain/args/windows:default_link_flags"],
        "//conditions:default": [],
    }),
)

cc_args_list(
    name = "linux_hosted_c_toolchain_args",
    args = select({
        "//platforms/config:musl": [
            "//toolchain/args/linux:kernel_headers_include_search_paths",
            "//toolchain/args/linux:musl_libc_headers_include_search_paths",
        ],
        "//platforms/config:gnu": [
            "//toolchain/args/linux:kernel_headers_include_search_paths",
            "//toolchain/args/linux:glibc_headers_include_search_paths",
        ],
        "//conditions:default": [],
    }) + select({
        "//platforms/config:musl": [
            # TODO: Handle musl dynamic linking.
            # musl implies static linking for now.
            "//toolchain/args:static_link_executable",
        ],
        "//conditions:default": [],
    }) + [
        "//toolchain/args/linux:sanitizer_headers_include_search_paths",
    ],
    visibility = ["//toolchain:__subpackages__"],
)

cc_args_list(
    name = "stage1_hosted_platform_specific_args",
    args = select({
        "@platforms//os:macos": [
            "//toolchain:macos_runtime_toolchain_args",
        ],
        "@platforms//os:linux": [
            ":linux_hosted_c_toolchain_args",
        ],
        # Windows uses the explicit composition in toolchain_args.bzl.
        "@platforms//os:windows": [],
        "@platforms//os:none": [],
        "@platforms//os:wasi": ["//toolchain:wasi_hosted_c_toolchain_args"],
    }),
    visibility = ["//toolchain:__subpackages__"],
)

cc_args_list(
    name = "platform_specific_args",
    args = select({
        "@platforms//os:macos": [
            "//toolchain:macos_runtime_toolchain_args",
        ],
        "@platforms//os:linux": [],
        # Windows uses the explicit composition in toolchain_args.bzl.
        "@platforms//os:windows": [],
        "@platforms//os:none": [],
        "@platforms//os:wasi": [],
    }),
    visibility = ["//toolchain:__subpackages__"],
)

runtime_toolchain_args(
    name = "stage0_toolchain_args",
    stage = "stage0",
)

runtime_toolchain_args(
    name = "stage1_toolchain_args",
    stage = "stage1",
)

runtime_toolchain_args(
    name = "stage1_hosted_toolchain_args",
    stage = "stage1_hosted",
)

bzl_library(
    name = "cc_runtime_library",
    srcs = ["cc_runtime_library.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "@llvm//toolchain/runtimes:with_cfg_runtimes_common",
        "@rules_cc//cc:core_rules",
        "@with_cfg.bzl//:with_cfg",
    ],
)

bzl_library(
    name = "cc_runtime_binary",
    srcs = ["cc_runtime_binary.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "@llvm//toolchain/runtimes:with_cfg_runtimes_common",
        "@rules_cc//cc:core_rules",
        "@with_cfg.bzl//:with_cfg",
    ],
)

bzl_library(
