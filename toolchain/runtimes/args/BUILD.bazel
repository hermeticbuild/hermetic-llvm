# TODO(cerisier): this needs to differ per runtime (e.g libc++ still need crtbegin)
cc_args(
    name = "hermetic_link_flags",
    actions = [
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    args = select({
        "//toolchain:runtimes_all": [],
        "//toolchain:runtimes_stage1": [
            "-nostdlib++",
        ],
        "//toolchain:runtimes_stage1_hosted": [
            "-nostdlib++",
        ],
        "//toolchain:runtimes_none": [
            "-nostdlib",
        ],
    }),
)
