load("@rules_cc//cc/toolchains:args.bzl", "cc_args")
load("@rules_cc//cc/toolchains/impl:documented_api.bzl", "cc_args_list")

package(default_visibility = ["//toolchain/runtimes:__subpackages__"])

# Runtime optimization/debug policy applies to the same logical source actions
# for every compiler driver dialect. Raw assemble actions stay excluded because
# they do not consume C-family optimization or preprocessor semantics.
RUNTIME_SOURCE_COMPILE_ACTIONS = [
    "@rules_cc//cc/toolchains/actions:cpp_compile_actions",
    "@rules_cc//cc/toolchains/actions:c_compile_actions",
    "@rules_cc//cc/toolchains/actions:preprocess_assemble",
    "@rules_cc//cc/toolchains/actions:objc_compile",
    "@rules_cc//cc/toolchains/actions:objcpp_compile",
]

cc_args(
    name = "opt_disable_assertions",
    actions = RUNTIME_SOURCE_COMPILE_ACTIONS,
    args = select({
        "//constraints/windows/abi:msvc": ["/DNDEBUG"],
        "//conditions:default": ["-DNDEBUG"],
    }),
)

cc_args(
    name = "opt_optimization_level",
    actions = RUNTIME_SOURCE_COMPILE_ACTIONS,
    args = select({
        "//constraints/windows/abi:msvc": ["/O2"],
        "//conditions:default": ["-O2"],
    }),
)

cc_args(
    name = "dbg_runtime_debug_define",
    actions = RUNTIME_SOURCE_COMPILE_ACTIONS,
    args = select({
        # The MSVC route declares retail CRTs only. _DEBUG must remain absent
        # until a debug CRT becomes a supported, declared runtime choice.
        "//constraints/windows/abi:msvc": [],
        "//conditions:default": ["-D_DEBUG"],
    }),
)

cc_args(
    name = "dbg_no_optimization",
    actions = RUNTIME_SOURCE_COMPILE_ACTIONS,
    args = select({
        "//constraints/windows/abi:msvc": ["/Od"],
        "//conditions:default": ["-O0"],
    }),
)

cc_args(
    name = "dbg_debug_info",
    actions = RUNTIME_SOURCE_COMPILE_ACTIONS,
    args = select({
        "//constraints/windows/abi:msvc": ["/Z7"],
        "//conditions:default": ["-g"],
    }),
)

cc_args_list(
    name = "optimization_flags",
    args = select({
        "//config:runtimes_optimization_mode_debug": [
            ":dbg_runtime_debug_define",
            ":dbg_no_optimization",
            ":dbg_debug_info",
        ],
        "//conditions:default": [
            ":opt_disable_assertions",
            ":opt_optimization_level",
        ],
    }),
)

cc_args_list(
    name = "ubsan_flags",
    args = select({
        # We just need to recompile with sanitizer flags, don't need linker flags.
        # And in fact linker flags will cause a cycle. If we ever need a sanitizer
        # for compilation, we would need an extra bootstrap stage.
        "//config:ubsan_enabled": [
            "//toolchain/args:ubsan_compiler_flags",
        ],
        "//conditions:default": [],
    }),
)

