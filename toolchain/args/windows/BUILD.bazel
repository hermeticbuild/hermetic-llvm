load("@rules_cc//cc/toolchains/impl:documented_api.bzl", "cc_args_list")

package(default_visibility = ["//visibility:public"])

# This package owns Windows semantic routing between target ABI/environment
# implementations. Each selected implementation may refine deeper CRT, SDK,
# and runtime dimensions. Complete rules_cc argument ordering and composition
# remains in //toolchain and //toolchain/runtimes.

cc_args_list(
    name = "default_link_flags",
    args = select({
        "//constraints/windows/abi:msvc": ["//toolchain/args/windows/msvc:default_console_subsystem_link_flags"],
        "//conditions:default": [],
    }),
)

cc_args_list(
    name = "default_startfiles",
    args = select({
        "//constraints/windows/abi:msvc": [],
        "//conditions:default": ["//toolchain/args:crt_search_directory"],
    }),
)

cc_args_list(
    name = "default_libs",
    args = select({
        # MSVC SDK representation follows the execution filesystem, so each
        # concrete cc_toolchain instance supplies its complete default-lib
        # composition. Target-configured MinGW remains selected here.
        "//constraints/windows/abi:msvc": [],
        "//conditions:default": ["//toolchain/args/windows/mingw:default_libs"],
    }),
)

