# MinGW serves the libc++ headers from split public/detail directories so that
# the public headers can be compiled into a Clang module (see
# //runtimes/cxxstdlib).
cc_args_list(
    name = "cxxstdlib_headers_include_search_paths",
    args = select({
        "//constraints/windows/abi:msvc": ["//toolchain/args:clang_cl_cxxstdlib_headers_include_search_paths"],
        "//conditions:default": ["//toolchain/args:split_cxxstdlib_headers_include_search_paths"],
    }),
)

# MinGW target headers already precede the compiler resource directory. The
# MSVC SDK headers remain in cc_toolchain's deferred post-resource append.
cc_args_list(
    name = "headers_before_compiler_resource",
    args = select({
        "//constraints/windows/abi:msvc": [],
        "//conditions:default": ["//toolchain/args/windows/mingw:mingw_headers_include_search_paths"],
    }),
)
