load("@rules_cc//cc/toolchains:args.bzl", "cc_args")
load("@rules_cc//cc/toolchains/impl:documented_api.bzl", "cc_args_list")

package(default_visibility = ["//toolchain/args/windows:__pkg__"])

# TODO: Load this from an EULA-free metadata repository once windows_support
# exposes one. Keep it synchronized with msvc_runtime.configure in MODULE.bazel.
_MSVC_COMPATIBILITY_VERSION = "19.50.35717"

_FRONTEND_ACTIONS = [
    "@rules_cc//cc/toolchains/actions:c_compile",
    "@rules_cc//cc/toolchains/actions:cpp_compile",
    "@rules_cc//cc/toolchains/actions:linkstamp_compile",
    "@rules_cc//cc/toolchains/actions:preprocess_assemble",
    "@rules_cc//cc/toolchains/actions:cpp_header_parsing",
]

cc_args(
    name = "compatibility",
    actions = [
        "@rules_cc//cc/toolchains/actions:lto_backend",
    ] + _FRONTEND_ACTIONS,
    args = [
        "/clang:-fms-compatibility-version={}".format(_MSVC_COMPATIBILITY_VERSION),
    ],
)

cc_args(
    name = "deterministic_coff_object_flags",
    actions = [
        "@rules_cc//cc/toolchains/actions:source_compile_actions",
    ],
    args = ["/Brepro"],
)

cc_args(
    name = "windows_sdk_compile_defines",
    actions = _FRONTEND_ACTIONS,
    args = ["/DNOMINMAX"],
)

cc_args(
    name = "msvc_crt_compile_defines",
    actions = _FRONTEND_ACTIONS,
    args = [
        "/D_CRT_NONSTDC_NO_WARNINGS",
        "/D_CRT_SECURE_NO_DEPRECATE",
        "/D_CRT_SECURE_NO_WARNINGS",
        "/D_CRT_STDIO_ISO_WIDE_SPECIFIERS",
    ],
)

cc_args(
    name = "deterministic_codeview_flags",
    actions = _FRONTEND_ACTIONS,
    args = ["/clang:-gno-codeview-command-line"],
)

cc_args(
    name = "target_machine_link_flags",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = select({
        "//platforms/config:windows_x86_64_msvc": [
            "/clang:-Xlinker",
            "/clang:/MACHINE:X64",
        ],
        "//platforms/config:windows_aarch64_msvc": [
            "/clang:-Xlinker",
            "/clang:/MACHINE:ARM64",
        ],
        "//conditions:default": [],
    }),
)

cc_args(
    name = "deterministic_link_flags",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = [
        "/Brepro",
        "/clang:-Xlinker",
        "/clang:/INCREMENTAL:NO",
        "/clang:-Xlinker",
        "/clang:/lldignoreenv",
        "/clang:-Xlinker",
        "/clang:/PDBALTPATH:%_PDB%",
        "/clang:-Xlinker",
        "/clang:/pdbsourcepath:.",
    ],
)

cc_args(
    name = "default_console_subsystem_link_flags",
    actions = ["@rules_cc//cc/toolchains/actions:link_executable_actions"],
    args = [
        "/clang:-Xlinker",
        "/clang:/SUBSYSTEM:CONSOLE",
    ],
)

cc_args(
    name = "sdk_header_case_overlay",
    actions = _FRONTEND_ACTIONS,
    args = [
        "/clang:-ivfsoverlay",
        "/clang:{sdk_header_case_overlay}",
    ],
    data = ["//runtimes/msvc:msvc_sdk_header_case_overlay"],
    format = {
        "sdk_header_case_overlay": "//runtimes/msvc:msvc_sdk_header_case_overlay",
    },
)

cc_args(
    name = "sdk_includes",
    actions = _FRONTEND_ACTIONS,
    allowlist_include_directories = ["//runtimes/msvc:header_sysroot"],
    # Explicit SDK locations also prevent host INCLUDE/EXTERNAL_INCLUDE
    # discovery. User /imsvc directories retain their native precedence.
    args = [
        "/vctoolsdir{headers}/vc",
        "/winsdkdir{headers}/sdk",
        "/winsdkversion10.0.0",
    ],
    data = ["//runtimes/msvc:header_sysroot"],
    format = {"headers": "//runtimes/msvc:header_sysroot"},
)

cc_args(
    name = "com_support_library_search_paths",
    actions = [
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    args = [
        "/clang:-Xlinker",
        "/clang:/LIBPATH:{com_support_library_search_path}",
    ],
    data = ["//runtimes/msvc:msvc_com_support_libraries"],
    format = {
        "com_support_library_search_path": "//runtimes/msvc:msvc_com_support_libraries",
    },
)

cc_args(
    name = "dynamic_crt_library_search_paths",
    actions = [
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    args = [
        "/clang:-Xlinker",
        "/clang:/LIBPATH:{dynamic_crt_library_search_path}",
    ],
    data = ["//runtimes/msvc:msvc_dynamic_runtime_libraries"],
    format = {
        "dynamic_crt_library_search_path": "//runtimes/msvc:msvc_dynamic_runtime_libraries",
    },
)

cc_args(
    name = "static_crt_library_search_paths",
    actions = [
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    args = [
        "/clang:-Xlinker",
        "/clang:/LIBPATH:{static_crt_library_search_path}",
    ],
    data = ["//runtimes/msvc:msvc_static_runtime_libraries"],
    format = {
        "static_crt_library_search_path": "//runtimes/msvc:msvc_static_runtime_libraries",
    },
)

cc_args(
    name = "sdk_library_search_paths",
    actions = [
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    args = [
        "/clang:-Xlinker",
        "/clang:/vfsoverlay:{sdk_library_case_overlay}",
        "/clang:-Xlinker",
        "/clang:/LIBPATH:{winsdk_ucrt_lib}",
        "/clang:-Xlinker",
        "/clang:/LIBPATH:{winsdk_um_lib}",
    ],
    data = [
        "//runtimes/msvc:msvc_sdk_library_case_overlay",
        "//runtimes/msvc:winsdk_ucrt_lib",
        "//runtimes/msvc:winsdk_um_lib",
    ],
    format = {
        "sdk_library_case_overlay": "//runtimes/msvc:msvc_sdk_library_case_overlay",
        "winsdk_ucrt_lib": "//runtimes/msvc:winsdk_ucrt_lib",
        "winsdk_um_lib": "//runtimes/msvc:winsdk_um_lib",
    },
)

cc_args_list(
    name = "normalized_sdk_compile_args",
    args = [
        "windows_sdk_compile_defines",
        "sdk_header_case_overlay",
        "sdk_includes",
    ],
    visibility = ["//visibility:public"],
)

cc_args_list(
    name = "normalized_default_libs",
    args = [
        "sdk_library_search_paths",
        "com_support_library_search_paths",
    ] + select({
        "//toolchain/features/msvc:static_crt_config": ["static_crt_library_search_paths"],
        "//conditions:default": ["dynamic_crt_library_search_paths"],
    }) + select({
        # Hosted C construction tools need the target CRT and SDK, but do not
        # consume the C++ standard library.
        "//toolchain:runtimes_stage1_hosted": [],
        "//conditions:default": ["//toolchain/args:clang_cl_static_libcxx_default_lib"],
    }),
    visibility = ["//visibility:public"],
)

cc_args_list(
    name = "normalized_default_libs_for_runtime",
    args = select({
        "//toolchain:runtimes_none": [],
        "//conditions:default": [":normalized_default_libs"],
    }),
    visibility = ["//visibility:public"],
)
