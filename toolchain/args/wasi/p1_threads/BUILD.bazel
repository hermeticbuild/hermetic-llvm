load("@rules_cc//cc/toolchains:args.bzl", "cc_args")

package(default_visibility = ["//toolchain/args/wasi:__pkg__"])

cc_args(
    name = "thread_model",
    actions = ["@rules_cc//cc/toolchains/actions:source_compile_actions"],
    # Pthread mode and its TLS policy implement this runtime's thread model.
    args = [
        "-mthread-model",
        "posix",
        "-pthread",
        "-ftls-model=local-exec",
    ],
    target_compatible_with = [
        "//constraints/wasi:p1_threads",
        "@platforms//cpu:wasm32",
        "@platforms//os:wasi",
    ],
)

cc_args(
    name = "target_features",
    actions = ["@rules_cc//cc/toolchains/actions:source_compile_actions"],
    args = ["-matomics"],
    target_compatible_with = [
        "//constraints/wasi:p1_threads",
        "@platforms//cpu:wasm32",
        "@platforms//os:wasi",
    ],
)
