load("@rules_cc//cc/toolchains:args.bzl", "cc_args")
load("@rules_cc//cc/toolchains/impl:documented_api.bzl", "cc_args_list")

package(default_visibility = ["//toolchain:__subpackages__"])

cc_args(
    name = "libc_headers_include_search_paths",
    actions = ["//toolchain:source_compile_actions"],
    args = [
        "-isystem",
        "{wasi_headers}",
    ],
    data = ["//runtimes/wasi:wasi_headers_include_search_directory"],
    format = {"wasi_headers": "//runtimes/wasi:wasi_headers_include_search_directory"},
    target_compatible_with = ["@platforms//os:wasi"],
)

cc_args(
    name = "default_startfiles",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    # Clang selects the command or reactor CRT. For now these objects share
    # the libc directory; directory separation is independent of this semantic.
    args = ["-B{wasi_libs}"],
    data = ["//runtimes/wasi:wasi_library_search_directory"],
    format = {"wasi_libs": "//runtimes/wasi:wasi_library_search_directory"},
    target_compatible_with = ["@platforms//os:wasi"],
)

cc_args(
    name = "default_libs",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = ["-L{wasi_libs}"],
    data = ["//runtimes/wasi:wasi_library_search_directory"],
    format = {"wasi_libs": "//runtimes/wasi:wasi_library_search_directory"},
    target_compatible_with = ["@platforms//os:wasi"],
    visibility = ["//visibility:public"],
)

cc_args_list(
    name = "thread_model",
    args = select({
        "//platforms/config:wasi_wasm32_p1_threads": ["//toolchain/args/wasi/p1_threads:thread_model"],
        "//platforms/config:wasi_components": ["//toolchain/args/wasi/components:thread_model"],
        "//conditions:default": ["//toolchain/args/wasi/p1:thread_model"],
    }),
    target_compatible_with = ["@platforms//os:wasi"],
)

cc_args_list(
    name = "target_features",
    args = select({
        "//platforms/config:wasi_wasm32_p1_threads": ["//toolchain/args/wasi/p1_threads:target_features"],
        "//conditions:default": [],
    }),
    target_compatible_with = ["@platforms//os:wasi"],
)

cc_args_list(
    name = "linker",
    args = select({
        "//platforms/config:wasi_components": ["//toolchain/args/wasi/components:linker"],
        "//conditions:default": ["//toolchain/args:fuse_lld"],
    }),
    target_compatible_with = ["@platforms//os:wasi"],
)
