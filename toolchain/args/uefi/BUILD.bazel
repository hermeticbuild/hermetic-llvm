load("@bazel_lib//lib:run_binary.bzl", "run_binary")
load("@rules_cc//cc/toolchains:args.bzl", "cc_args")

package(default_visibility = ["//visibility:public"])

run_binary(
    name = "fltused",
    srcs = ["fltused.c"],
    outs = ["fltused.o"],
    args = ["-target"] + select({
        "@platforms//cpu:x86_64": ["x86_64-unknown-windows"],
        "@platforms//cpu:aarch64": ["aarch64-unknown-windows"],
    }) + [
        "-fno-ms-compatibility",
        "-fno-ms-extensions",
        "-ffreestanding",
        "-c",
        "$(location :fltused.c)",
        "-o",
        "$@",
    ],
    tool = "@llvm//tools:clang",
)

cc_args(
    name = "default_link_flags",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = [
        "-Wl,/subsystem:efi_application",
        "-Wl,/entry:efi_main",
        "-Wl,/base:0x0",
        "-Wl,/brepro",
        "{fltused}",
    ],
    data = [":fltused"],
    format = {"fltused": ":fltused"},
)

# Keep the Windows ABI while accepting GNU source extensions such as
# __attribute__((packed)).
cc_args(
    name = "hybrid_gnu_msvc",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = [
        "-D_MSC_VER=1920",
        "-ffreestanding",
        "-fno-ms-compatibility",
        "-fno-ms-extensions",
    ],
)

cc_args(
    name = "nostdlib",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = [
        "-nostdlib",
        "-Wl,/nodefaultlib",
        "-Wl,/lldignoreenv",
    ],
)
