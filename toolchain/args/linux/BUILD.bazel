load("@rules_cc//cc/toolchains:args.bzl", "cc_args")
load("@rules_cc//cc/toolchains/impl:documented_api.bzl", "cc_args_list")

package(default_visibility = ["//visibility:public"])

# Use separate public and detail header directories for libc++ modules.
# libstdc++ keeps a single directory.
cc_args_list(
    name = "cxxstdlib_headers_include_search_paths",
    args = select({
        "//runtimes/cxxstdlib:libstdcxx_linux": ["//toolchain/args:default_cxxstdlib_headers_include_search_paths"],
        "//conditions:default": ["//toolchain/args:split_cxxstdlib_headers_include_search_paths"],
    }),
)

# Extracted from rules_cc unix_cc_configure.bzl
# TODO(cerisier): Extract those into proper semantic args list.
cc_args(
    name = "default_link_flags",
    actions = [
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    args = [
        "-Wl,-no-as-needed",
        "-Wl,-z,relro,-z,now",
        # Distribution GCC and Clang builds emit a build ID by default. The
        # SHA-1 of the output is deterministic, unlike --build-id=uuid.
        "-Wl,--build-id=sha1",
    ],
)

cc_args(
    name = "non_pie_executable_link_flags",
    actions = [
        "@rules_cc//cc/toolchains/actions:link_executable_actions",
    ],
    # Clang 22 defaults Linux links to PIE. Preserve Bazel's non-force_pic
    # executable semantics for GNU targets.
    args = select({
        "//platforms/config:gnu": ["-no-pie"],
        "//conditions:default": [],
    }),
    requires_none = "@rules_cc//cc/toolchains/variables:force_pic",
)

# The runtime library and unwinder selected by //config:rtlib and
# //config:unwindlib. The toolchain links its own libunwind as a runtime
# library, so the driver adds an unwinder only for unwindlib=libgcc.
cc_args_list(
    name = "rtlib",
    args = select({
        "//config:rtlib_libgcc": ["//toolchain/args:rtlib_libgcc"],
        "//conditions:default": ["//toolchain/args:rtlib_compiler_rt"],
    }),
)

cc_args_list(
    name = "unwindlib",
    args = select({
        "//config:unwindlib_libgcc": ["//toolchain/args:unwindlib_libgcc"],
        "//conditions:default": ["//toolchain/args:unwindlib_none"],
    }),
)

# The empty libunwind and libgcc_s archives stand in for the toolchain's
# libunwind. Without it, -lunwind and -lgcc_s must find the consumer's.
cc_args_list(
    name = "libunwind_library_search_paths",
    args = select({
        "//config:unwindlib_libunwind": ["//toolchain/args:libunwind_library_search_paths"],
        "//conditions:default": [],
    }),
)

cc_args(
    name = "kernel_headers_include_search_paths",
    actions = [
        "//toolchain:source_compile_actions",
    ],
    allowlist_include_directories = [
        "@kernel_headers//:kernel_headers_directory",
    ],
    # Preserve musl's existing include flags. GNU uses the driver's native
    # extern-C category after builtins.
    args = select({
        "//platforms/config:musl": ["-isystem"],
        "//conditions:default": [
            "-Xclang",
            "-internal-externc-isystem",
            "-Xclang",
        ],
    }) + ["{kernel_headers_include_search_path}"],
    data = [
        "@kernel_headers//:kernel_headers_directory",
    ],
    format = {
        "kernel_headers_include_search_path": "@kernel_headers//:kernel_headers_directory",
    },
    target_compatible_with = ["@platforms//os:linux"],
)

cc_args(
    name = "glibc_headers_include_search_paths",
    actions = [
        "//toolchain:source_compile_actions",
    ],
    allowlist_include_directories = [
        "//runtimes/glibc:glibc_headers_include_search_directory",
    ],
    args = [
        "-Xclang",
        "-internal-externc-isystem",
        "-Xclang",
        "{libc_headers_include_search_path}",
    ] + select({
        # glibc 2.17 hides the C99 integer macros in C++ unless requested.
        # Modern libc++ expects them unconditionally, as glibc >= 2.18 does.
        "//constraints/libc:gnu.2.17": [
            "-D__STDC_CONSTANT_MACROS",
            "-D__STDC_LIMIT_MACROS",
            "-D__STDC_FORMAT_MACROS",
        ],
        "//conditions:default": [],
    }),
    data = [
        "//runtimes/glibc:glibc_headers_include_search_directory",
    ],
    format = {
        "libc_headers_include_search_path": "//runtimes/glibc:glibc_headers_include_search_directory",
    },
    target_compatible_with = ["@platforms//os:linux"],
)

cc_args(
    name = "sanitizer_headers_include_search_paths",
    actions = [
        "//toolchain:source_compile_actions",
    ],
    allowlist_include_directories = [
        "//sanitizers:sanitizers_headers_include_search_directory",
    ],
    # Make sure these sanitizer paths come after any user supplied paths, which
    # might also include another version of llvm's sanitizer headers.
    args = [
        "-Xclang",
        "-internal-isystem",
        "-Xclang",
        "{sanitizer_headers_include_search_paths}",
    ],
    data = [
        "//sanitizers:sanitizers_headers_include_search_directory",
    ],
    format = {
        "sanitizer_headers_include_search_paths": "//sanitizers:sanitizers_headers_include_search_directory",
    },
)

cc_args(
    name = "default_libs_gnu",
    actions = [
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    args = [
        # We need to support copts like -lc -ldl etc...
        "-L{libc_library_search_path}",

        # In prevention of when all of those can be shared libraries.
        "-Wl,--push-state",
        "-Wl,--as-needed",

        # Since libunwind is linked statically, we need to link pthread as well.
        "-lpthread",
        # Since libunwind is linked statically, we need to link dl as well.
        "-ldl",
        "-Wl,--pop-state",
    ],
    data = [
        "//runtimes/glibc:glibc_library_search_directory",
    ],
    format = {
        "libc_library_search_path": "//runtimes/glibc:glibc_library_search_directory",
    },
)

###

cc_args(
    name = "musl_libc_headers_include_search_paths",
    actions = [
        "//toolchain:source_compile_actions",
    ],
    args = [
        "-isystem",
        "{libc_headers_include_search_path}",
    ],
    data = [
        "//runtimes/musl:musl_headers_include_search_directory",
    ],
    format = {
        "libc_headers_include_search_path": "//runtimes/musl:musl_headers_include_search_directory",
    },
)

#TODO: Factorize this and gnu
cc_args(
    name = "default_libs_musl",
    actions = [
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    args = [
        # We need to support copts like -lc -ldl etc...
        "-L{libc_library_search_path}",

        # In prevention of when all of those can be shared libraries.
        "-Wl,--push-state",
        "-Wl,--as-needed",

        # Since libunwind is linked statically, we need to link pthread as well.
        "-lpthread",
        # Since libunwind is linked statically, we need to link dl as well.
        "-ldl",
        "-Wl,--pop-state",
    ],
    data = [
        "//runtimes/musl:musl_library_search_directory",
    ],
    format = {
        "libc_library_search_path": "//runtimes/musl:musl_library_search_directory",
    },
    target_compatible_with = ["@platforms//os:linux"],
)

alias(
    name = "default_libs",
    actual = select({
        "//platforms/config:musl": ":default_libs_musl",
        "//platforms/config:gnu": ":default_libs_gnu",
    }),
    target_compatible_with = ["@platforms//os:linux"],
)
