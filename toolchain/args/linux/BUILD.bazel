#TODO: Factorize this and gnu
cc_args(
    name = "default_libs_musl",
    actions = [
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    args = [
        # We need to support copts like -lc -ldl etc...
        "-L{libc_library_search_path}",

        # In prevention of when all of those can be shared libraries.
        "-Wl,--push-state",
        "-Wl,--as-needed",

        # Since libunwind is linked statically, we need to link pthread as well.
        "-lpthread",
        # Since libunwind is linked statically, we need to link dl as well.
        "-ldl",
        "-Wl,--pop-state",
    ],
    data = [
        "//runtimes/musl:musl_library_search_directory",
    ],
    format = {
        "libc_library_search_path": "//runtimes/musl:musl_library_search_directory",
    },
    target_compatible_with = ["@platforms//os:linux"],
)

alias(
    name = "default_libs",
    actual = select({
        "//platforms/config:musl": ":default_libs_musl",
        "//platforms/config:gnu": ":default_libs_gnu",
    }),
    target_compatible_with = ["@platforms//os:linux"],
)

cc_args(
    name = "header_sysroot",
    actions = [
        "//toolchain:source_compile_actions",
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    allowlist_include_directories = ["//toolchain/headers:linux"],
    args = [
        "--sysroot={headers}",
        "--gcc-toolchain=/dev/null",
    ],
    data = ["//toolchain/headers:linux"],
    format = {"headers": "//toolchain/headers:linux"},
)

cc_args_list(
    name = "sysroot_flags",
    args = select({
        "//toolchain:hosted_headers": ["header_sysroot"],
        "//conditions:default": ["//toolchain/args:empty_sysroot_flags"],
    }),
)

cc_args_list(
    name = "hermetic_compile_flags",
    args = select({
        "//toolchain:hosted_headers": [],
        "//conditions:default": ["//toolchain/args:hermetic_compile_flags"],
    }),
)
