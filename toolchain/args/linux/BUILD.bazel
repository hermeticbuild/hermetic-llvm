load("@rules_cc//cc/toolchains:args.bzl", "cc_args")
load("@rules_cc//cc/toolchains/impl:documented_api.bzl", "cc_args_list")

package(default_visibility = ["//visibility:public"])

# Extracted from rules_cc unix_cc_configure.bzl
# TODO(cerisier): Extract those into proper semantic args list.
cc_args(
    name = "default_link_flags",
    actions = [
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    args = [
        "-Wl,-no-as-needed",
        "-Wl,-z,relro,-z,now",
    ],
)

cc_args(
    name = "non_pie_executable_link_flags",
    actions = [
        "@rules_cc//cc/toolchains/actions:link_executable_actions",
    ],
    # Clang 22 defaults Linux links to PIE. Preserve Bazel's non-force_pic
    # executable semantics for GNU targets.
    args = select({
        "//platforms/config:gnu": ["-no-pie"],
        "//conditions:default": [],
    }),
    requires_none = "@rules_cc//cc/toolchains/variables:force_pic",
)

cc_args(
    name = "kernel_headers_include_search_paths",
    actions = [
        "//toolchain:source_compile_actions",
    ],
    allowlist_include_directories = [
        "@kernel_headers//:kernel_headers_directory",
    ],
    args = [
        "-isystem",
        "{kernel_headers_include_search_path}",
    ],
    data = [
        "@kernel_headers//:kernel_headers_directory",
    ],
    format = {
        "kernel_headers_include_search_path": "@kernel_headers//:kernel_headers_directory",
    },
    target_compatible_with = ["@platforms//os:linux"],
)

cc_args(
    name = "glibc_headers_include_search_paths",
    actions = [
        "//toolchain:source_compile_actions",
    ],
    allowlist_include_directories = [
        "//runtimes/glibc:glibc_headers_include_search_directory",
    ],
    args = [
        # "__GLIBC_MINOR__={d}", version.minor
        "-isystem",
        "{libc_headers_include_search_path}",
    ] + select({
        # glibc 2.17 hides the C99 integer macros in C++ unless requested.
        # Modern libc++ expects them unconditionally, as glibc >= 2.18 does.
        "//constraints/libc:gnu.2.17": [
            "-D__STDC_CONSTANT_MACROS",
            "-D__STDC_LIMIT_MACROS",
            "-D__STDC_FORMAT_MACROS",
        ],
        "//conditions:default": [],
    }),
    data = [
        "//runtimes/glibc:glibc_headers_include_search_directory",
    ],
    format = {
        "libc_headers_include_search_path": "//runtimes/glibc:glibc_headers_include_search_directory",
    },
    target_compatible_with = ["@platforms//os:linux"],
)

cc_args(
    name = "sanitizer_headers_include_search_paths",
    actions = [
        "//toolchain:source_compile_actions",
    ],
    allowlist_include_directories = [
        "//sanitizers:sanitizers_headers_include_search_directory",
    ],
    # Make sure these sanitizer paths come after any user supplied paths, which
    # might also include another version of llvm's sanitizer headers.
    args = [
        "-Xclang",
        "-internal-isystem",
        "-Xclang",
        "{sanitizer_headers_include_search_paths}",
    ],
    data = [
        "//sanitizers:sanitizers_headers_include_search_directory",
    ],
    format = {
        "sanitizer_headers_include_search_paths": "//sanitizers:sanitizers_headers_include_search_directory",
    },
)

# Explicit linkopts such as -lc or -ldl still need the libc search path
# when the target disables the C++ runtimes. This applies to both glibc and musl.
cc_args(
    name = "glibc_library_search_path",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = ["-L{libc_library_search_path}"],
    data = ["//runtimes/glibc:glibc_library_search_directory"],
    format = {"libc_library_search_path": "//runtimes/glibc:glibc_library_search_directory"},
)

# When libunwind is linked statically, the final link must supply its pthread
# and dl dependencies. A target that opts out of the C++ runtimes omits libunwind.
cc_args(
    name = "libunwind_system_libraries",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = [
        # If pthread or dl is shared, omit its DT_NEEDED entry when it is unused.
        # Restore the previous --as-needed setting for subsequent libraries.
        "-Wl,--push-state",
        "-Wl,--as-needed",
        "-lpthread",
        "-ldl",
        "-Wl,--pop-state",
    ],
    # The runtime bootstrap toolchains do not define this feature.
    requires_any_of = select({
        "//toolchain:runtimes_all": ["//toolchain/features:static_link_cpp_runtimes"],
        "//conditions:default": [],
    }),
)

cc_args_list(
    name = "default_libs_gnu",
    args = [
        ":glibc_library_search_path",
        ":libunwind_system_libraries",
    ],
)

###

cc_args(
    name = "musl_libc_headers_include_search_paths",
    actions = [
        "//toolchain:source_compile_actions",
    ],
    args = [
        "-isystem",
        "{libc_headers_include_search_path}",
    ],
    data = [
        "//runtimes/musl:musl_headers_include_search_directory",
    ],
    format = {
        "libc_headers_include_search_path": "//runtimes/musl:musl_headers_include_search_directory",
    },
)

cc_args(
    name = "musl_library_search_path",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = ["-L{libc_library_search_path}"],
    data = ["//runtimes/musl:musl_library_search_directory"],
    format = {"libc_library_search_path": "//runtimes/musl:musl_library_search_directory"},
)

cc_args_list(
    name = "default_libs_musl",
    args = [
        ":musl_library_search_path",
        ":libunwind_system_libraries",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

alias(
    name = "default_libs",
    actual = select({
        "//platforms/config:musl": ":default_libs_musl",
        "//platforms/config:gnu": ":default_libs_gnu",
    }),
    target_compatible_with = ["@platforms//os:linux"],
)
