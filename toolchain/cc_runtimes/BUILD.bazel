load("@bazel_lib//:bzl_library.bzl", "bzl_library")
load(":cc_runtimes.bzl", "cc_runtimes_library", "cc_runtimes_toolchain")

package(default_visibility = ["//visibility:public"])

# Compile libc++ once so importing modules don't embed conflicting copies.
# The runtime dependency also adds it to each target's module map, which
# layering_check requires.
#
# Keep textual headers in the toolchain's module map, which records their
# sizes for lazy lookup. Repeating them here would make rules_cc omit the
# sizes and Clang stat every header when loading this module's map.
cc_runtimes_library(
    name = "libcxx",
    hdrs = ["//runtimes/cxxstdlib:public_headers_directory"],
    features = [
        "header_modules",
        "use_header_modules",
        "layering_check",
    ],
    tags = [
        # Build only when a dependent target imports the module.
        "manual",
    ],
)

cc_runtimes_toolchain(
    name = "runtimes",
    runtimes = [":libcxx"],
)

bzl_library(
    name = "cc_runtimes",
    srcs = ["cc_runtimes.bzl"],
    deps = [
        "@rules_cc//cc:find_cc_toolchain_bzl",
        "@rules_cc//cc/common",
    ],
)
