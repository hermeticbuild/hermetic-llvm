    args = [
        "/clang:-Xclang",
        "/clang:-fmodule-map-file-home-is-cwd",
    ],
)

cc_feature(
    name = "module_map_home_cwd",
    args = [":module_map_home_cwd_args"],
    feature_name = "module_map_home_cwd",
    requires_any_of = [":module_maps"],
)

