load("@rules_cc//cc/toolchains:args.bzl", "cc_args")
load("@rules_cc//cc/toolchains:feature.bzl", "cc_feature")
load("@rules_cc//cc/toolchains:feature_set.bzl", "cc_feature_set")

package(default_visibility = ["//visibility:public"])

# Based on https://github.com/bazelbuild/bazel/issues/4005#issuecomment-1212952697.
# Targets can import modules without compiling their own headers as modules.
# Keep the two opt-ins independent, as in the Android NDK toolchain.
# https://github.com/bazelbuild/rules_android_ndk/blob/8ba0720dcf044fc1cdd82ca8160df0dd394f8711/ndk_cc_toolchain_config.bzl#L538-L573

_MODULE_CONSUMING_ACTIONS = [
    "@rules_cc//cc/toolchains/actions:cpp_compile",
    "@rules_cc//cc/toolchains/actions:cpp_header_parsing",
    "@rules_cc//cc/toolchains/actions:cpp_module_compile",
    "@rules_cc//cc/toolchains/actions:cpp_module_codegen",
]

cc_feature(
    name = "header_modules",
    feature_name = "header_modules",
    implies = [":header_module_compile"],
    requires_any_of = [":use_header_modules"],
)

# Keep -x before the source by defining these flags in
# //toolchain/args:header_module_compile.
cc_feature(
    name = "header_module_compile",
    feature_name = "header_module_compile",
)

cc_feature(
    name = "header_module_codegen",
    feature_name = "header_module_codegen",
    requires_any_of = [":header_modules"],
)

cc_args(
    name = "header_modules_codegen_functions_args",
    actions = ["@rules_cc//cc/toolchains/actions:cpp_module_compile"],
    args = [
        "-Xclang",
        "-fmodules-codegen",
    ],
)

cc_feature(
    name = "header_modules_codegen_functions",
    args = [":header_modules_codegen_functions_args"],
    feature_name = "header_modules_codegen_functions",
    implies = [":header_module_codegen"],
)

cc_args(
    name = "header_modules_codegen_debuginfo_args",
    actions = ["@rules_cc//cc/toolchains/actions:cpp_module_compile"],
    args = [
        "-Xclang",
        "-fmodules-debuginfo",
    ],
)

cc_feature(
    name = "header_modules_codegen_debuginfo",
    args = [":header_modules_codegen_debuginfo_args"],
    feature_name = "header_modules_codegen_debuginfo",
    implies = [":header_module_codegen"],
)

cc_args(
    name = "use_header_modules_args",
    actions = _MODULE_CONSUMING_ACTIONS,
    args = [
        "-fmodules",
        "-fno-implicit-modules",
        "-fno-implicit-module-maps",
        "-Wno-modules-ambiguous-internal-linkage",
        "-Wno-module-import-in-extern-c",
        "-Wno-modules-import-nested-redundant",
    ],
)

cc_args(
    name = "use_header_modules_module_files_args",
    actions = _MODULE_CONSUMING_ACTIONS,
    args = [
        "-Xclang",
        "-fmodule-file={module_files}",
    ],
    format = {
        "module_files": "@rules_cc//cc/toolchains/variables:module_files",
    },
    iterate_over = "@rules_cc//cc/toolchains/variables:module_files",
    requires_not_none = "@rules_cc//cc/toolchains/variables:module_files",
)

# Like the module map arguments of rules_cc's layering_check and
# use_module_maps features, but only for the actions that consume modules. C
# compiles can't use them and would only parse the module maps, including the
# toolchain's with every system header. layering_check still passes the module
# maps to all compiles.
cc_args(
    name = "use_header_modules_module_name_args",
    actions = _MODULE_CONSUMING_ACTIONS,
    args = ["-fmodule-name={module_name}"],
    format = {
        "module_name": "@rules_cc//cc/toolchains/variables:module_name",
    },
    requires_not_none = "@rules_cc//cc/toolchains/variables:module_name",
)

cc_args(
    name = "use_header_modules_module_map_file_args",
    actions = _MODULE_CONSUMING_ACTIONS,
    args = ["-fmodule-map-file={module_map_file}"],
    format = {
        "module_map_file": "@rules_cc//cc/toolchains/variables:module_map_file",
    },
    requires_not_none = "@rules_cc//cc/toolchains/variables:module_map_file",
)

cc_args(
    name = "use_header_modules_dependent_module_map_files_args",
    actions = _MODULE_CONSUMING_ACTIONS,
    args = ["-fmodule-map-file={dependent_module_map_files}"],
    format = {
        "dependent_module_map_files": "@rules_cc//cc/toolchains/variables:dependent_module_map_files",
    },
    iterate_over = "@rules_cc//cc/toolchains/variables:dependent_module_map_files",
    requires_not_none = "@rules_cc//cc/toolchains/variables:dependent_module_map_files",
)

cc_feature(
    name = "use_header_modules",
    args = [
        ":use_header_modules_module_name_args",
        ":use_header_modules_module_map_file_args",
        ":use_header_modules_dependent_module_map_files_args",
        ":use_header_modules_args",
        ":use_header_modules_module_files_args",
    ],
    feature_name = "use_header_modules",
)

cc_feature_set(
    name = "all_header_module_features",
    all_of = [
        ":header_modules",
        ":header_module_compile",
        ":header_module_codegen",
        ":header_modules_codegen_functions",
        ":header_modules_codegen_debuginfo",
        ":use_header_modules",
    ],
)
