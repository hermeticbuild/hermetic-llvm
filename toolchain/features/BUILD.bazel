load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_cc//cc/toolchains:args.bzl", "cc_args")
load("@rules_cc//cc/toolchains:feature.bzl", "cc_feature")
load("@rules_cc//cc/toolchains:feature_set.bzl", "cc_feature_set")
load("@rules_cc//cc/toolchains/impl:documented_api.bzl", "cc_args_list")

package(default_visibility = ["//visibility:public"])

_DEBUG_INFO_COMPILE_ACTIONS = [
    "@rules_cc//cc/toolchains/actions:c_compile",
    "@rules_cc//cc/toolchains/actions:cpp_compile",
    "@rules_cc//cc/toolchains/actions:lto_backend",
    "@rules_cc//cc/toolchains/actions:objc_compile",
    "@rules_cc//cc/toolchains/actions:objcpp_compile",
]

# rules_cc's compile_actions group also contains raw assembly. clang-cl's
# source-language optimization and debug options do not apply there, while
# preprocessed assembly still needs the preprocessor-facing subset.
_CONFIGURATION_COMPILE_ACTIONS = select({
    "//constraints/windows/abi:msvc": [
        "@rules_cc//cc/toolchains/actions:c_compile",
        "@rules_cc//cc/toolchains/actions:cpp_compile",
        "@rules_cc//cc/toolchains/actions:linkstamp_compile",
        "@rules_cc//cc/toolchains/actions:preprocess_assemble",
        "@rules_cc//cc/toolchains/actions:cpp_header_parsing",
        "@rules_cc//cc/toolchains/actions:lto_backend",
    ],
    "//conditions:default": ["@rules_cc//cc/toolchains/actions:compile_actions"],
})

_FINAL_LINK_ACTIONS = [
    "@rules_cc//cc/toolchains/actions:cpp_link_dynamic_library",
    "@rules_cc//cc/toolchains/actions:cpp_link_executable",
    "@rules_cc//cc/toolchains/actions:cpp_link_nodeps_dynamic_library",
    "@rules_cc//cc/toolchains/actions:objc_executable",
]

# [x] opt
# [x] dbg
# [] fastbuild
# [] static_linking_mode - does this do anything? Seems obsolete
# [] dynamic_linking_mode
# [x] per_object_debug_info
# [x] static_link_cpp_runtimes

cc_feature(
    name = "static_link_cpp_runtimes",
    overrides = "@rules_cc//cc/toolchains/features:static_link_cpp_runtimes",
)

cc_args(
    name = "no_exceptions_args",
    # Preserve the generic Clang behavior previously provided by --copt,
    # whose user_compile_flags expansion covers rules_cc compile_actions.
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = ["-fno-exceptions"],
)

cc_feature(
    name = "no_exceptions",
    args = [":no_exceptions_args"],
    feature_name = "no_exceptions",
)

cc_args(
    name = "no_rtti_args",
    # Preserve the generic Clang behavior previously provided by --copt,
    # whose user_compile_flags expansion covers rules_cc compile_actions.
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = ["-fno-rtti"],
)

cc_feature(
    name = "no_rtti",
    args = [":no_rtti_args"],
    feature_name = "no_rtti",
)

cc_args(
    name = "omit_frame_pointer_args",
    # Preserve the generic Clang behavior previously provided by --copt,
    # including C compilation and ThinLTO backend code generation.
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = ["-fomit-frame-pointer"],
)

cc_feature(
    name = "omit_frame_pointer",
    args = [":omit_frame_pointer_args"],
    feature_name = "omit_frame_pointer",
)

cc_feature_set(
    name = "compiler_policy_features",
    all_of = [
        ":no_exceptions",
        ":no_rtti",
        ":omit_frame_pointer",
    ],
)

cc_feature(
    name = "prefer_pic_for_opt_binaries",
    feature_name = "prefer_pic_for_opt_binaries",
)

# Bazel uses these opt-in features to reuse library code generation across links.
cc_feature(
    name = "thin_lto_linkstatic_tests_use_shared_nonlto_backends",
    feature_name = "thin_lto_linkstatic_tests_use_shared_nonlto_backends",
)

cc_feature(
    name = "thin_lto_all_linkstatic_use_shared_nonlto_backends",
    feature_name = "thin_lto_all_linkstatic_use_shared_nonlto_backends",
)

# Allow external repositories to get included with -isystem instead of -I in
# order to silence warnings from external headers. The complete generic and
# Windows toolchain compositions expand external_include_paths before their
# target C and C++ include semantics.
cc_feature(
    name = "external_include_paths",
    feature_name = "external_include_paths",
)

cc_feature(
    name = "copy_dynamic_libraries_to_binary",
    feature_name = "copy_dynamic_libraries_to_binary",
)

cc_feature(
    name = "targets_windows",
    feature_name = "targets_windows",
    implies = [":copy_dynamic_libraries_to_binary"],
)

cc_feature(
    name = "windows_export_all_symbols",
    feature_name = "windows_export_all_symbols",
)

cc_feature(
    name = "no_windows_export_all_symbols",
    feature_name = "no_windows_export_all_symbols",
)

cc_feature(
    name = "sanitize_pwd",
    feature_name = "sanitize_pwd",
)

# --icf=safe is LLD/ELF-only: sanitizer runtimes forbid ICF, wasm and Windows
# don't support it, and macOS links with ld64 (which rejects the flag). Grouped
# via match_any so overlapping conditions (e.g. macOS + a sanitizer) don't
# produce an ambiguous select.
selects.config_setting_group(
    name = "_icf_unsupported",
    match_any = [
        "//config:asan_enabled",
        "//config:cfi_enabled",
        "//config:dfsan_enabled",
        "//config:lsan_enabled",
        "//config:msan_enabled",
        "//config:nsan_enabled",
        "//config:rtsan_enabled",
        "//config:safestack_enabled",
        "//config:tsan_enabled",
        "//config:tysan_enabled",
        "//config:ubsan_enabled",
        "@platforms//cpu:wasm32",
        "@platforms//cpu:wasm64",
        "@platforms//os:macos",
        "@platforms//os:windows",
    ],
)

cc_args(
    name = "opt_link_flags",
    actions = [
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    args = select({
        "@platforms//os:macos": [
            #TODO: should be on a config that match ld64 specifically
            "-Wl,-dead_strip",
        ],
        "@platforms//os:windows": [],
        "//conditions:default": [
            #TODO: should be somehow done only if the choosen linker supports it
            "-Wl,--gc-sections",
        ],
    }) + select({
        ":_icf_unsupported": [],
        "//conditions:default": ["-Wl,--icf=safe"],
    }),
)

cc_args(
    name = "opt_no_debug_info",
    actions = _CONFIGURATION_COMPILE_ACTIONS,
    args = select({
        # clang-cl emits no CodeView unless a /Z debug option is requested.
        "//constraints/windows/abi:msvc": [],
        "//conditions:default": [
            # No debug symbols.
            # Maybe we should enable https://gcc.gnu.org/wiki/DebugFission for opt or
            # even generally? However, that can't happen here, as it requires special
            # handling in Bazel.
            "-g0",
        ],
    }),
)

cc_args(
    name = "opt_optimization_level",
    actions = _CONFIGURATION_COMPILE_ACTIONS,
    args = select({
        "//constraints/windows/abi:msvc": ["/O2"],
        "//conditions:default": [
            # Conservative choice for -O
            # -O3 can increase binary size and even slow down the resulting binaries.
            # Profile first and / or use FDO if you need better performance than this.
            "-O2",
        ],
    }),
)

cc_args(
    name = "opt_fortify",
    actions = _CONFIGURATION_COMPILE_ACTIONS,
    args = select({
        # VCRuntime provides its own checked-runtime policy; _FORTIFY_SOURCE is
        # a glibc-family source contract, not a clang-cl spelling problem.
        "//constraints/windows/abi:msvc": [],
        "//conditions:default": [
            # Security hardening on by default.
            # Conservative choice; -D_FORTIFY_SOURCE=2 may be unsafe in some cases.
            "-D_FORTIFY_SOURCE=1",
        ],
    }),
)

cc_args(
    name = "opt_disable_assertions",
    actions = _CONFIGURATION_COMPILE_ACTIONS,
    args = select({
        "//constraints/windows/abi:msvc": ["/DNDEBUG"],
        "//conditions:default": [
            # Disable assertions
            "-DNDEBUG",
        ],
    }),
)

cc_args(
    name = "opt_function_sections",
    actions = _CONFIGURATION_COMPILE_ACTIONS,
    args = select({
        "//constraints/windows/abi:msvc": ["/Gy"],
        "//conditions:default": [
            # Removal of unused code and data at link time (can this increase binary
            # size in some cases?).
            "-ffunction-sections",
        ],
    }),
)

cc_args(
    name = "opt_data_sections",
    actions = _CONFIGURATION_COMPILE_ACTIONS,
    args = select({
        "//constraints/windows/abi:msvc": ["/Gw"],
        "//conditions:default": [
            "-fdata-sections",
        ],
    }),
)

cc_args(
    name = "opt_inline_elimination",
    actions = _CONFIGURATION_COMPILE_ACTIONS,
    args = select({
        "//constraints/windows/abi:msvc": ["/Zc:inline"],
        # Generic Clang's section and linker-GC policy already owns dead-code
        # removal; it has no separate driver option equivalent to /Zc:inline.
        "//conditions:default": [],
    }),
)

cc_args_list(
    name = "opt_compile_flags",
    args = [
        ":opt_no_debug_info",
        ":opt_optimization_level",
        ":opt_fortify",
        ":opt_disable_assertions",
        ":opt_function_sections",
        ":opt_data_sections",
        ":opt_inline_elimination",
    ],
)

# Use a stub feature so we can properly control flag ordering.
cc_feature(
    name = "opt",
    args = [
        ":opt_compile_flags",
        ":opt_link_flags",
    ],
    feature_name = "_underlying_opt",
    requires_any_of = [":opt_stub"],
)

cc_feature(
    name = "opt_stub",
    overrides = "@rules_cc//cc/toolchains/features:opt",
)

cc_args(
    name = "dbg_runtime_debug_define",
    actions = _CONFIGURATION_COMPILE_ACTIONS,
    args = select({
        # Only retail /MD and /MT are supported. _DEBUG would select debug CRT
        # behavior that the declared Microsoft runtime closure does not provide.
        "//constraints/windows/abi:msvc": [],
        "//conditions:default": [
            # windows c runtime requires -D_DEBUG if using debug libraries
            "-D_DEBUG",
        ],
    }),
)

cc_args(
    name = "dbg_no_optimization",
    actions = _CONFIGURATION_COMPILE_ACTIONS,
    args = select({
        "//constraints/windows/abi:msvc": ["/Od"],
        "//conditions:default": [
            # Clang has -Og for compatibility with GCC, but currently it is just equivalent
            # to -O1. Besides potentially impairing debugging, -O1/-Og significantly
            # increases compile times.
            "-O0",
        ],
    }),
)

cc_args(
    name = "dbg_debug_info",
    actions = _CONFIGURATION_COMPILE_ACTIONS,
    args = select({
        "//constraints/windows/abi:msvc": ["/Z7"],
        "//conditions:default": [
            # Debug symbols.
            "-g",
        ],
    }),
)

cc_args_list(
    name = "dbg_compile_flags",
    args = [
        ":dbg_runtime_debug_define",
        ":dbg_no_optimization",
        ":dbg_debug_info",
    ],
)

# Use a stub feature so we can properly control flag ordering.
cc_feature(
    name = "dbg",
    args = [
        ":dbg_compile_flags",
    ],
    feature_name = "_underlying_dbg",
    implies = select({
        "//constraints/windows/abi:msvc": [":generate_pdb_file"],
        "//conditions:default": [],
    }),
    requires_any_of = [":dbg_stub"],
)

cc_feature(
    name = "dbg_stub",
    overrides = "@rules_cc//cc/toolchains/features:dbg",
)

cc_feature(
    name = "archive_param_file",
    feature_name = "archive_param_file",
)

cc_feature(
    name = "parse_headers_wrapper",
    args = [
        "//toolchain/args:parse_header_args",
    ],
    feature_name = "__parse_headers_wrapper",
    requires_any_of = [":parse_headers"],
)

cc_feature(
    name = "parse_headers",
    feature_name = "parse_headers",
)

cc_args(
    name = "generate_dsym_file_compile_args",
    actions = _DEBUG_INFO_COMPILE_ACTIONS,
    args = ["-g"],
)

cc_args(
    name = "generate_dsym_file_link_args",
    actions = _FINAL_LINK_ACTIONS,
    env = {
        "LLVM_DSYM_PATH": "{dsym_path}",
        "LLVM_LINK_OUTPUT": "{output_execpath}",
    },
    format = {
        "dsym_path": "@rules_cc//cc/toolchains/variables:dsym_path",
        "output_execpath": "@rules_cc//cc/toolchains/variables:output_execpath",
    },
    requires_not_none = "@rules_cc//cc/toolchains/variables:dsym_path",
)

cc_feature(
    name = "generate_dsym_file",
    args = [
        ":generate_dsym_file_compile_args",
        ":generate_dsym_file_link_args",
    ],
    overrides = "@rules_cc//cc/toolchains/features/legacy:generate_dsym_file",
)

cc_args(
    name = "generate_pdb_file_compile_args",
    actions = _DEBUG_INFO_COMPILE_ACTIONS,
    args = select({
        "//constraints/windows/abi:msvc": ["/Z7"],
        "//conditions:default": ["-gcodeview"],
    }),
)

cc_args(
    name = "generate_pdb_file_link_args",
    actions = _FINAL_LINK_ACTIONS,
    args = ["-Wl,--pdb="],
)

cc_feature(
    name = "generate_pdb_file",
    args = [":generate_pdb_file_compile_args"] + select({
        "//constraints/windows/abi:msvc": ["//toolchain/features/msvc:pdb_args"],
        "//conditions:default": [":generate_pdb_file_link_args"],
    }),
    feature_name = "generate_pdb_file",
)

