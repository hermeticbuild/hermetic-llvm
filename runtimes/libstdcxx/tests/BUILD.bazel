load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//:defs.bzl", "exec_test")
load("//3rd_party/gcc:version.bzl", "DEFAULT_GCC_VERSION", "GCC_VERSIONS", "gcc_repository_label", "gcc_target_suffix", "libstdcxx_constraint_value")
load("//constraints/libc:libc_versions.bzl", "default_libc")

package(default_visibility = ["//visibility:public"])

sh_test(
    name = "shared_elf_test",
    srcs = ["libstdcxx_shared_elf_test.sh"],
    data = [
        "//runtimes/libstdcxx:libstdcxx.shared",
        "//runtimes/libstdcxx:libstdcxx_shared_linker_name",
        "//runtimes/libstdcxx:libstdcxx_shared_soname",
        "@llvm//tools:llvm-readelf",
    ],
    env = {
        "LIBSTDCXX_SHARED": "$(rootpath //runtimes/libstdcxx:libstdcxx.shared)",
        "LIBSTDCXX_SHARED_LINKER_NAME": "$(rootpath //runtimes/libstdcxx:libstdcxx_shared_linker_name)",
        "LIBSTDCXX_SHARED_SONAME": "$(rootpath //runtimes/libstdcxx:libstdcxx_shared_soname)",
        "READELF": "$(rootpath @llvm//tools:llvm-readelf)",
    },
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

cc_binary(
    name = "toolchain_dynamic_link_smoke",
    srcs = [
        "libstdcxx_legacy_list.cc",
        "libstdcxx_runtime.cc",
    ],
    linkstatic = False,
    target_compatible_with = select({
        "//constraints/cxxstdlib:libstdcxx": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }) + [
        "@platforms//os:linux",
    ],
)

cc_binary(
    name = "toolchain_static_link_smoke",
    srcs = [
        "libstdcxx_legacy_list.cc",
        "libstdcxx_runtime.cc",
    ],
    linkstatic = True,
    target_compatible_with = select({
        "//constraints/cxxstdlib:libstdcxx": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }) + [
        "@platforms//os:linux",
    ],
)

# Pin the execution tests' glibc baseline so the resulting binaries can run
# in the Ubuntu 22.04 execution container.
platform(
    name = "runtime_test_linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "//constraints/libc:gnu.2.28",
        "//constraints/cxxstdlib:" + libstdcxx_constraint_value(DEFAULT_GCC_VERSION),
    ],
)

[
    platform_transition_filegroup(
        name = "runtime_{}_linux_x86_64".format(linkage),
        srcs = [":toolchain_{}_link_smoke".format(linkage)],
        target_compatible_with = select({
            "@platforms//os:linux": [],
            "//conditions:default": ["@platforms//:incompatible"],
        }),
        target_platform = ":runtime_test_linux_x86_64",
    )
    for linkage in [
        "static",
        "dynamic",
    ]
]

[
    exec_test(
        name = "runtime_{}_test".format(linkage),
        srcs = ["libstdcxx_runtime_test.sh"],
        data = [
            ":runtime_{}_linux_x86_64".format(linkage),
            "@llvm//tools:llvm-readelf",
        ],
        env = {
            "BINARY": "$(rootpath :runtime_{}_linux_x86_64)".format(linkage),
            "LINKAGE": linkage,
            "READELF": "$(rootpath @llvm//tools:llvm-readelf)",
        },
        rule = sh_test,
        target_compatible_with = [
            "@platforms//cpu:x86_64",
            "@platforms//os:linux",
        ],
    )
    for linkage in [
        "static",
        "dynamic",
    ]
]

[
    platform(
        name = "linux_{}_{}".format(
            arch,
            libstdcxx_constraint_value(version),
        ),
        constraint_values = [
            "@platforms//cpu:{}".format(arch),
            "@platforms//os:linux",
            "//constraints/libc:{}".format(default_libc("linux", arch)),
            "//constraints/cxxstdlib:{}".format(libstdcxx_constraint_value(version)),
        ],
    )
    for arch in [
        "x86_64",
        "aarch64",
    ]
    for version in GCC_VERSIONS
]

[
    platform_transition_filegroup(
        name = "toolchain_dynamic_link_smoke_linux_{}_{}".format(
            arch,
            gcc_target_suffix(version),
        ),
        srcs = [":toolchain_dynamic_link_smoke"],
        target_platform = ":linux_{}_{}".format(
            arch,
            libstdcxx_constraint_value(version),
        ),
    )
    for arch in [
        "x86_64",
        "aarch64",
    ]
    for version in GCC_VERSIONS
]

[
    filegroup(
        name = "toolchain_dynamic_link_smoke_linux_{}_all_versions".format(arch),
        srcs = [
            ":toolchain_dynamic_link_smoke_linux_{}_{}".format(
                arch,
                gcc_target_suffix(version),
            )
            for version in GCC_VERSIONS
        ],
    )
    for arch in [
        "x86_64",
        "aarch64",
    ]
]

filegroup(
    name = "toolchain_dynamic_link_smoke_linux_all_versions",
    srcs = [
        ":toolchain_dynamic_link_smoke_linux_aarch64_all_versions",
        ":toolchain_dynamic_link_smoke_linux_x86_64_all_versions",
    ],
)

[
    platform_transition_filegroup(
        name = "toolchain_static_link_smoke_linux_{}_{}".format(
            arch,
            gcc_target_suffix(version),
        ),
        srcs = [":toolchain_static_link_smoke"],
        target_platform = ":linux_{}_{}".format(
            arch,
            libstdcxx_constraint_value(version),
        ),
    )
    for arch in [
        "x86_64",
        "aarch64",
    ]
    for version in GCC_VERSIONS
]

filegroup(
    name = "toolchain_static_link_smoke_linux_all_versions",
    srcs = [
        ":toolchain_static_link_smoke_linux_{}_{}".format(
            arch,
            gcc_target_suffix(version),
        )
        for arch in [
            "x86_64",
            "aarch64",
        ]
        for version in GCC_VERSIONS
    ],
)

[
    platform_transition_filegroup(
        name = "libstdcxx_cxx26_compile_linux_{}_{}".format(
            arch,
            gcc_target_suffix(version),
        ),
        srcs = [gcc_repository_label(version, "libstdcxx_cxx26")],
        target_platform = ":linux_{}_{}".format(
            arch,
            libstdcxx_constraint_value(version),
        ),
    )
    for arch in [
        "x86_64",
        "aarch64",
    ]
    for version in GCC_VERSIONS
]

[
    filegroup(
        name = "libstdcxx_cxx26_compile_linux_{}_all_versions".format(arch),
        srcs = [
            ":libstdcxx_cxx26_compile_linux_{}_{}".format(
                arch,
                gcc_target_suffix(version),
            )
            for version in GCC_VERSIONS
        ],
    )
    for arch in [
        "x86_64",
        "aarch64",
    ]
]

filegroup(
    name = "libstdcxx_cxx26_compile_linux_all_versions",
    srcs = [
        ":libstdcxx_cxx26_compile_linux_aarch64_all_versions",
        ":libstdcxx_cxx26_compile_linux_x86_64_all_versions",
    ],
)

cc_binary(
    name = "libsupcxx_link_smoke",
    srcs = ["libsupcxx_link_smoke.cc"],
    linkopts = ["-lsupc++"],
    linkstatic = False,
    target_compatible_with = select({
        "//constraints/cxxstdlib:libstdcxx": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }) + ["@platforms//os:linux"],
)
