load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//3rd_party/gcc:version.bzl", "GCC_VERSIONS", "gcc_repository_label", "gcc_target_suffix", "libstdcxx_constraint_value", "select_gcc_version_at_least")
load("//constraints/libc:libc_versions.bzl", "default_libc")

package(default_visibility = ["//visibility:public"])

[
    cc_library(
        name = "filesystem_{}_abi{}".format(api, abi),
        srcs = ["filesystem_test.cc"],
        copts = [
            "-std=c++17",
            "-D_GLIBCXX_USE_CXX11_ABI={}".format(abi),
            "-DFS_TEST_FUNCTION=filesystem_abi{}".format(abi),
        ] + (["-DFS_TEST_EXPERIMENTAL"] if api == "ts" else []),
        target_compatible_with = select({
            "//constraints/cxxstdlib:libstdcxx": [],
            "//conditions:default": ["@platforms//:incompatible"],
        }) + [
            "@platforms//os:linux",
        ],
    )
    for api in [
        "std",
        "ts",
    ]
    for abi in [
        0,
        1,
    ]
]

[
    cc_test(
        name = "filesystem_{}_test".format(api),
        srcs = ["filesystem_test_main.cc"],
        linkopts = ["-lstdc++fs"] if api == "ts" else select_gcc_version_at_least(
            "9.0.0",
            [],
            ["-lstdc++fs"],
        ),
        linkstatic = False,
        target_compatible_with = select({
            "//constraints/cxxstdlib:libstdcxx": [],
            "//conditions:default": ["@platforms//:incompatible"],
        }) + [
            "@platforms//os:linux",
        ],
        # GCC 8 and the TS use a static libstdc++fs archive. Pull in both ABI
        # objects, old first, so duplicate _Dir definitions cannot hide.
        deps = [":filesystem_{}_abi{}".format(api, abi) for abi in [
            0,
            1,
        ]],
    )
    for api in [
        "std",
        "ts",
    ]
]

sh_test(
    name = "shared_elf_test",
    srcs = ["libstdcxx_shared_elf_test.sh"],
    data = [
        "//runtimes/libstdcxx:libstdcxx.shared",
        "//runtimes/libstdcxx:libstdcxx_shared_linker_name",
        "//runtimes/libstdcxx:libstdcxx_shared_soname",
        "@llvm//tools:llvm-readelf",
    ],
    env = {
        "LIBSTDCXX_SHARED": "$(rootpath //runtimes/libstdcxx:libstdcxx.shared)",
        "LIBSTDCXX_SHARED_LINKER_NAME": "$(rootpath //runtimes/libstdcxx:libstdcxx_shared_linker_name)",
        "LIBSTDCXX_SHARED_SONAME": "$(rootpath //runtimes/libstdcxx:libstdcxx_shared_soname)",
        "READELF": "$(rootpath @llvm//tools:llvm-readelf)",
    },
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

filegroup(
    name = "link_smoke_sources",
    srcs = [
        "libstdcxx_legacy_list.cc",
        "libstdcxx_runtime.cc",
    ],
)

[
    cc_binary(
        name = "toolchain_{}_link_smoke".format(linkage),
        srcs = [":link_smoke_sources"],
        linkstatic = linkage == "static",
        target_compatible_with = select({
            "//constraints/cxxstdlib:libstdcxx": [],
            "//conditions:default": ["@platforms//:incompatible"],
        }) + [
            "@platforms//os:linux",
        ],
    )
    for linkage in [
        "static",
        "dynamic",
    ]
]

[
    platform(
        name = "linux_{}_{}".format(
            arch,
            libstdcxx_constraint_value(version),
        ),
        constraint_values = [
            "@platforms//cpu:{}".format(arch),
            "@platforms//os:linux",
            "//constraints/libc:{}".format(default_libc("linux", arch)),
            "//constraints/cxxstdlib:{}".format(libstdcxx_constraint_value(version)),
        ],
    )
    for arch in [
        "x86_64",
        "aarch64",
    ]
    for version in GCC_VERSIONS
]

[
    platform_transition_filegroup(
        name = "toolchain_{}_link_smoke_linux_{}_{}".format(
            linkage,
            arch,
            gcc_target_suffix(version),
        ),
        srcs = [":toolchain_{}_link_smoke".format(linkage)],
        target_platform = ":linux_{}_{}".format(
            arch,
            libstdcxx_constraint_value(version),
        ),
    )
    for linkage in [
        "static",
        "dynamic",
    ]
    for arch in [
        "x86_64",
        "aarch64",
    ]
    for version in GCC_VERSIONS
]

[
    filegroup(
        name = "toolchain_{}_link_smoke_linux_{}_all_versions".format(linkage, arch),
        srcs = [
            ":toolchain_{}_link_smoke_linux_{}_{}".format(
                linkage,
                arch,
                gcc_target_suffix(version),
            )
            for version in GCC_VERSIONS
        ],
    )
    for linkage in [
        "static",
        "dynamic",
    ]
    for arch in [
        "x86_64",
        "aarch64",
    ]
]

[
    filegroup(
        name = "toolchain_{}_link_smoke_linux_all_versions".format(linkage),
        srcs = [
            ":toolchain_{}_link_smoke_linux_{}_all_versions".format(linkage, arch)
            for arch in [
                "x86_64",
                "aarch64",
            ]
        ],
    )
    for linkage in [
        "static",
        "dynamic",
    ]
]

[
    platform_transition_filegroup(
        name = "libstdcxx_cxx26_compile_linux_{}_{}".format(
            arch,
            gcc_target_suffix(version),
        ),
        srcs = [gcc_repository_label(version, "libstdcxx_cxx26")],
        target_platform = ":linux_{}_{}".format(
            arch,
            libstdcxx_constraint_value(version),
        ),
    )
    for arch in [
        "x86_64",
        "aarch64",
    ]
    for version in GCC_VERSIONS
]

[
    filegroup(
        name = "libstdcxx_cxx26_compile_linux_{}_all_versions".format(arch),
        srcs = [
            ":libstdcxx_cxx26_compile_linux_{}_{}".format(
                arch,
                gcc_target_suffix(version),
            )
            for version in GCC_VERSIONS
        ],
    )
    for arch in [
        "x86_64",
        "aarch64",
    ]
]

filegroup(
    name = "libstdcxx_cxx26_compile_linux_all_versions",
    srcs = [
        ":libstdcxx_cxx26_compile_linux_aarch64_all_versions",
        ":libstdcxx_cxx26_compile_linux_x86_64_all_versions",
    ],
)

cc_binary(
    name = "libsupcxx_link_smoke",
    srcs = ["libsupcxx_link_smoke.cc"],
    linkopts = ["-lsupc++"],
    linkstatic = False,
    target_compatible_with = select({
        "//constraints/cxxstdlib:libstdcxx": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }) + ["@platforms//os:linux"],
)
