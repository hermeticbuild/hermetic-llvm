diff --git a/libc/thread/pt.internal.h b/libc/thread/pt.internal.h
--- a/libc/thread/pt.internal.h
+++ b/libc/thread/pt.internal.h
@@ -11,4 +11,7 @@
 #define PT_EXITING        128
 #define PT_OWNSIGALTSTACK 256
 
