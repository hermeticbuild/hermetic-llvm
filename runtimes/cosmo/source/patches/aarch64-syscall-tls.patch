diff --git a/libc/thread/tls.h b/libc/thread/tls.h
--- a/libc/thread/tls.h
+++ b/libc/thread/tls.h
@@ -2,6 +2,9 @@
 #define COSMOPOLITAN_LIBC_THREAD_TLS_H_
 
 #define TLS_ALIGNMENT 64
+
+#define COSMO_TIB_SIZE           1024
+#define COSMO_TIB_PTHREAD_OFFSET 0x28
 
 #define TIB_FLAG_VFORKED 1
 
@@ -65,13 +68,21 @@
  *
  * This can't be used in privileged functions.
  */
-forceinline pureconst struct CosmoTib *__get_tls(void) {
+#if !defined(__aarch64__) || !defined(__clang__)
+pureconst
+#endif
+forceinline struct CosmoTib *__get_tls(void) {
 #ifdef __chibicc__
   return 0;
 #elif __x86_64__
   struct CosmoTib *__tib;
   __asm__("mov\t%%gs:0x30,%0" : "=r"(__tib));
   return __tib;
+#elif defined(__aarch64__) && defined(__clang__)
+  // `__set_tls` can change x28 even within the calling function.
+  struct CosmoTib *__tls;
+  __asm__ volatile("mov\t%0,x28" : "=r"(__tls));
+  return __tls - 1;
 #elif defined(__aarch64__)
   register struct CosmoTib *__tls __asm__("x28");
   return __tls - 1;
