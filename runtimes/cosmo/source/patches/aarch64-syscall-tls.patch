diff --git a/libc/sysv/systemfive.S b/libc/sysv/systemfive.S
--- a/libc/sysv/systemfive.S
+++ b/libc/sysv/systemfive.S
@@ -19,6 +19,9 @@
 #include "libc/dce.h"
 #include "libc/macros.h"
 #include "libc/thread/pt.internal.h"
+#include "libc/thread/tls.h"
+
+#ifdef __x86_64__
 
 #define SIG_IGN 1
 
@@ -424,3 +427,152 @@
 _init_systemfive_done:
 	nop
 	.init.end 300,_init_systemfive,globl,hidden
+
+#elif defined(__aarch64__) && defined(__clang__)
+
+	.text
+	.p2align 2
+	.weak	_pthread_cancel_ack
+
+// `.scall` supplies x0-x5 and ordinals x8 (Linux), x9 (FreeBSD),
+// and x16 (XNU). Keep x0 and x1 intact on success for calls such as
+// XNU pipe that return two registers.
+systemfive:
+	.cfi_startproc
+	adrp	x10,__hostos
+	ldr	w10,[x10,:lo12:__hostos]
+#if SupportsXnu()
+	tst	w10,#_HOSTXNU
+	b.ne	.Lxnu
+#endif
+#if SupportsFreebsd()
+	tst	w10,#_HOSTFREEBSD
+	b.eq	1f
+	mov	x8,x9
+	b	.Lsysv
+1:
+#endif
+#if SupportsLinux()
+	tst	w10,#_HOSTLINUX
+	b.eq	.Lenosys
+#else
+	b	.Lenosys
+#endif
+.Lsysv:
+	cmp	x8,#0xfff
+	b.eq	.Lenosys
+	tbnz	x8,#11,.Lcancel_sysv
+.Lsyscall:
+	cmn	xzr,xzr			// Linux can preserve the carry flag.
+	svc	#0
+	b.cc	1f
+	neg	x0,x0			// BSD and XNU return positive errno with C set.
+1:
+	cmn	x0,#4095
+	b.lo	.Lreturn
+	b	_sysret
+.Lreturn:
+	ret
+.Lenosys:
+	adrp	x0,ENOSYS
+	ldr	w0,[x0,:lo12:ENOSYS]
+	neg	x0,x0
+	b	_sysret
+.Lcancel_sysv:
+	bic	x8,x8,#0x800
+	b	systemfive_cancellable
+#if SupportsXnu()
+.Lxnu:
+	cmp	x16,#0xfff
+	b.eq	.Lenosys
+	tbz	x16,#11,.Lsyscall
+	bic	x16,x16,#0x800
+	b	systemfive_cancellable
+#endif
+	.cfi_endproc
+	.endfn	systemfive,globl
+
+// Set x10 to the thread with cancellation enabled. Branch to the
+// supplied label if TLS, the thread, or pthread cancellation is absent.
+.macro	.cancelable_thread skip
+	adrp	x10,:got:_pthread_cancel_ack
+	ldr	x10,[x10,:got_lo12:_pthread_cancel_ack]
+	cbz	x10,\skip
+	cbz	x28,\skip
+	sub	x10,x28,#(COSMO_TIB_SIZE-COSMO_TIB_PTHREAD_OFFSET)
+	ldr	x10,[x10]
+	cbz	x10,\skip
+	ldr	w11,[x10,#PT_FLAGS_OFFSET]
+	tst	w11,#PT_NOCANCEL
+	b.ne	\skip
+.endm
+
+// pthread_cancel may redirect the saved PC from this interval to
+// systemfive_cancel. Keep sp and x30 unchanged throughout the interval.
+systemfive_cancellable:
+	.cfi_startproc
+	.cancelable_thread .Lcancellable_syscall
+	add	x11,x10,#PT_CANCELED_OFFSET
+	ldar	w11,[x11]
+	cbnz	w11,systemfive_cancel
+#if IsModeDbg()
+	ldr	w11,[x10,#PT_FLAGS_OFFSET]
+	tst	w11,#PT_INCANCEL
+	b.eq	.Lbad_cancel
+#endif
+.Lcancellable_syscall:
+	cmn	xzr,xzr
+	svc	#0
+systemfive_cancellable_end:
+	.globl	systemfive_cancellable_end
+	b.cc	1f
+	neg	x0,x0
+1:
+	cmn	x0,#4095
+	b.lo	.Lcancel_return
+	adrp	x10,EINTR
+	ldr	w10,[x10,:lo12:EINTR]
+	cmn	x0,x10
+	b.ne	.Lcancel_error
+	.cancelable_thread .Lcancel_error
+	add	x11,x10,#PT_CANCELED_OFFSET
+	ldar	w11,[x11]
+	cbnz	w11,systemfive_cancel
+.Lcancel_error:
+	b	_sysret
+.Lcancel_return:
+	ret
+	.cfi_endproc
+	.endfn	systemfive_cancellable,globl
+
+systemfive_cancel:
+	.cfi_startproc
+	b	_pthread_cancel_ack
+	.cfi_endproc
+	.endfn	systemfive_cancel,globl
+
+#if IsModeDbg()
+.Lbad_cancel:
+	.cfi_startproc
+	.weak	report_cancelation_point
+	adrp	x10,:got:report_cancelation_point
+	ldr	x10,[x10,:got_lo12:report_cancelation_point]
+	cbz	x10,.Lcancel_trap
+	mov	x0,x8
+	mov	x1,x16
+	stp	x29,x30,[sp,#-16]!
+	.cfi_def_cfa_offset 16
+	.cfi_offset x29,-16
+	.cfi_offset x30,-8
+	mov	x29,sp
+	blr	x10				// report_cancelation_point traps.
+	brk	#0
+	.cfi_restore x29
+	.cfi_restore x30
+	.cfi_def_cfa_offset 0
+.Lcancel_trap:
+	brk	#0
+	.cfi_endproc
+#endif
+
+#endif
