load("@llvm//:directory.bzl", "headers_directory")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "gnu_libc_headers",
    hdrs = ["include"],
    # Stage 0 runtime libraries consume this CcInfo directly rather than the
    # final toolchain's glibc_headers_include_search_paths argument set.
    defines = select({
        "@llvm//constraints/libc:gnu.2.17": [
            "__STDC_CONSTANT_MACROS",
            "__STDC_LIMIT_MACROS",
            "__STDC_FORMAT_MACROS",
        ],
        "//conditions:default": [],
    }),
    # user code should always get glibc headers as -isystem
    # but it seems glibc itself includes as <...>
    features = ["system_include_paths"],
    includes = ["include"],
    visibility = ["//visibility:public"],
)

headers_directory(
    name = "glibc_headers_directory",
    path = "include",
    visibility = ["//visibility:public"],
)
