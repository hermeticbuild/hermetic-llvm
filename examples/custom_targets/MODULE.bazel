module(
    name = "custom_targets_example",
    version = "0.0.0",
)

bazel_dep(name = "llvm", version = "")
local_path_override(
    module_name = "llvm",
    path = "../../",
)

# Overrides only apply in the root module, so this repeats the one in @llvm.
git_override(
    module_name = "platforms_contrib",
    commit = "3761bcf01e24afcedd9590831dc7b3284c766423",
    remote = "https://github.com/bazel-contrib/platforms_contrib.git",
)

bazel_dep(name = "rules_cc", version = "0.2.25")

toolchain = use_extension("@llvm//extensions:toolchain.bzl", "toolchain")
toolchain.exec(
    arch = "x86_64",
    os = "linux",
)
toolchain.exec(
    arch = "aarch64",
    os = "linux",
)
toolchain.target(
    arch = "x86_64",
    os = "linux",
)
toolchain.target(
    arch = "aarch64",
    os = "linux",
)
use_repo(toolchain, "llvm_toolchains")

register_toolchains("@llvm_toolchains//:all")
