load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_binary")

platform(
    name = "windows_x86_64_msvcstl",
    constraint_values = ["@llvm//constraints/cxxstdlib:msvcstl"],
    parents = ["@llvm//platforms:windows_x86_64_msvc"],
)

rust_binary(
    name = "main",
    srcs = ["main.rs"],
    experimental_use_cc_common_link = 1,
    link_deps = ["native"],
    tags = ["manual"],
)

cc_library(
    name = "native",
    # The Rust standard library uses NT APIs when linked through cc_common.link.
    linkopts = ["ntdll.lib"],
    deps = ["@llvm//tests/cxxstdlib_settings:msvcstl_probe"],
)
