load("@llvm//:cuda.bzl", "cuda_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":attributes_test.bzl", "device_features_test", "device_policy_test", "fatbinary_inputs_test", "host_decoupling_test", "host_features_test", "host_linking_test", "redirect_inputs_test")

cc_binary(
    name = "hello_world",
    srcs = [
        "hello_world.cc",
    ],
)

# device code + host wrapper function
cuda_library(
    name = "vector_cuda",
    srcs = ["vector_cuda.cu"],
    hdrs = ["vector_cuda.cu.h"],
    archs = [
        "sm_80",
        "sm_90",
        "sm_120",
    ],
    deps = [
        "@cuda//cuda:cuda_headers",
        # Clang force-includes curand_mtgp32_kernel.h in its CUDA wrapper.
        "@cuda//curand:headers",
        "@cuda//cccl:nv_headers",
    ],
)

# host only, calls host wrapper function
cc_binary(
    name = "vector_cuda_binary",
    srcs = [
        "vector_cuda_binary.cc",
    ],
    deps = [
        ":vector_cuda",
        "@cuda//cuda:cuda_headers",
        "@cuda//cudart",
    ],
)

cc_test(
    name = "vector_cuda_test",
    srcs = [
        "vector_cuda_test.cc",
    ],
    tags = [
        "local",
        "no-remote",
    ],
    deps = [
        ":vector_cuda",
        "@cuda//cuda:cuda_headers",
        "@cuda//cudart",
        "@googletest//:gtest_main",
    ],
)

cuda_library(
    name = "attribute_header_only",
    testonly = True,
    hdrs = ["attribute_headers/included.h"],
    defines = ["CUDA_LIBRARY_HEADER_ONLY=19"],
    includes = ["attribute_headers"],
)

cuda_library(
    name = "attribute_cuda",
    testonly = True,
    srcs = ["attribute_test.cu"],
    hdrs = ["attribute_headers/included.h"],
    additional_compiler_inputs = ["force_include.h"],
    archs = [
        "sm_80",
        "sm_120",
    ],
    copts = [
        "-include",
        "$(location :force_include.h)",
    ],
    defines = ["CUDA_LIBRARY_DEFINE=13"],
    features = ["-dbg"],
    includes = ["attribute_headers"],
    local_defines = ["CUDA_LIBRARY_LOCAL=17"],
    deps = [
        ":attribute_dependency",
        "@cuda//cccl:nv_headers",
        "@cuda//cuda:cuda_headers",
        "@cuda//curand:headers",
    ],
    alwayslink = True,
)

cc_test(
    name = "attributes_test",
    size = "small",
    srcs = ["attribute_test.cc"],
    # Loading CUDA runtime code needs the NVIDIA driver, even without a launch.
    tags = [
        "local",
        "no-remote",
    ],
    deps = [
        ":attribute_cuda",
        ":attribute_header_only",
        "@cuda//cudart",
    ],
)

host_features_test(
    name = "host_features_test",
    target_under_test = ":attribute_cuda__cuda_host_0_raw",
)

host_decoupling_test(
    name = "host_decoupling_test",
    target_under_test = ":attribute_cuda__cuda_host_0_raw",
)

redirect_inputs_test(
    name = "redirect_inputs_test",
    target_under_test = ":attribute_cuda__cuda_host_0_objects",
)

host_linking_test(
    name = "host_linking_test",
    target_under_test = ":attribute_cuda__cuda_host_0",
)

cuda_library(
    name = "decoupled",
    testonly = True,
    srcs = [
        "decoupled_a.cu",
        "decoupled_b.cu",
    ],
    archs = [
        "sm_80",
        "sm_120",
    ],
    host_deps = ["@cuda//cudart"],
    deps = [
        "@cuda//cccl:nv_headers",
        "@cuda//cuda:cuda_headers",
        "@cuda//curand:headers",
    ],
)

cc_test(
    name = "decoupled_test",
    srcs = ["decoupled_test.cc"],
    tags = [
        "local",
        "no-remote",
    ],
    deps = [
        ":cpu_only",
        ":decoupled",
    ],
)

cc_shared_library(
    name = "decoupled_shared",
    testonly = True,
    deps = [":decoupled"],
)

cc_test(
    name = "decoupled_shared_test",
    srcs = ["decoupled_test.cc"],
    dynamic_deps = [":decoupled_shared"],
    tags = [
        "local",
        "no-remote",
    ],
    deps = [
        ":cpu_only",
        ":decoupled",
    ],
)

cc_library(
    name = "cpu_only",
    testonly = True,
    srcs = ["cpu_only.cu"],
    additional_compiler_inputs = ["@llvm//toolchain/cuda:current_cuda_path"],
    copts = [
        "--offload-host-only",
        "--cuda-path=$(location @llvm//toolchain/cuda:current_cuda_path)",
    ],
    features = ["-thin_lto"],
    deps = [
        "@cuda//cccl:nv_headers",
        "@cuda//cuda:cuda_headers",
        "@cuda//curand:headers",
    ],
)

filegroup(
    name = "redirect_test_raw",
    testonly = True,
    srcs = [":decoupled__cuda_host_0_objects"],
    output_group = "raw_pic_objects",
)

filegroup(
    name = "redirect_test_cpu_only",
    testonly = True,
    srcs = [":cpu_only"],
    output_group = "compilation_outputs",
)

sh_test(
    name = "redirect_test",
    srcs = ["redirect_test.sh"],
    args = [
        "$(rootpath @llvm//tools/internal:cuda-redirect-test-driver)",
        "$(rootpath @llvm//tools/internal:cuda-redirect)",
        "$(rootpath :redirect_test_raw)",
        "$(rootpath :redirect_test_cpu_only)",
    ],
    data = [
        ":redirect_test_cpu_only",
        ":redirect_test_raw",
        "@llvm//tools/internal:cuda-redirect",
        "@llvm//tools/internal:cuda-redirect-test-driver",
    ],
)

device_features_test(
    name = "device_features_test",
    target_under_test = ":attribute_cuda__cuda_dev_0",
)

# This compiled dependency belongs to host linking, never to the fatbinary.
cc_library(
    name = "attribute_dependency",
    testonly = True,
    srcs = ["attribute_dependency.cc"],
)

fatbinary_inputs_test(
    name = "fatbinary_inputs_test",
    target_under_test = ":attribute_cuda__fatbin_0",
)

device_policy_test(
    name = "device_policy_test",
    target_under_test = ":attribute_cuda__cuda_dev_0",
)
