load("@llvm//:cuda.bzl", "cuda_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load(":attributes_test.bzl", "device_features_test", "device_policy_test", "fatbinary_inputs_test", "host_features_test")

cc_binary(
    name = "hello_world",
    srcs = [
        "hello_world.cc",
    ],
)

# device code + host wrapper function
cuda_library(
    name = "vector_cuda",
    srcs = ["vector_cuda.cu"],
    hdrs = ["vector_cuda.cu.h"],
    archs = [
        "sm_80",
        "sm_90",
        "sm_120",
    ],
    deps = [
        "@cuda//cuda:cuda_headers",
        # Clang force-includes curand_mtgp32_kernel.h in its CUDA wrapper.
        "@cuda//curand:headers",
        "@cuda//cccl:nv_headers",
    ],
)

# host only, calls host wrapper function
cc_binary(
    name = "vector_cuda_binary",
    srcs = [
        "vector_cuda_binary.cc",
    ],
    deps = [
        ":vector_cuda",
        "@cuda//cuda:cuda_headers",
        "@cuda//cudart",
    ],
)

cc_test(
    name = "vector_cuda_test",
    srcs = [
        "vector_cuda_test.cc",
    ],
    tags = [
        "local",
        "no-remote",
    ],
    deps = [
        ":vector_cuda",
        "@cuda//cuda:cuda_headers",
        "@cuda//cudart",
        "@googletest//:gtest_main",
    ],
)

cuda_library(
    name = "attribute_header_only",
    testonly = True,
    hdrs = ["attribute_headers/included.h"],
    defines = ["CUDA_LIBRARY_HEADER_ONLY=19"],
    includes = ["attribute_headers"],
)

cuda_library(
    name = "attribute_cuda",
    testonly = True,
    srcs = ["attribute_test.cu"],
    hdrs = ["attribute_headers/included.h"],
    additional_compiler_inputs = ["force_include.h"],
    archs = [
        "sm_80",
        "sm_120",
    ],
    copts = [
        "-include",
        "$(location :force_include.h)",
    ],
    defines = ["CUDA_LIBRARY_DEFINE=13"],
    features = ["-dbg"],
    includes = ["attribute_headers"],
    local_defines = ["CUDA_LIBRARY_LOCAL=17"],
    deps = [
        ":attribute_dependency",
        "@cuda//cccl:nv_headers",
        "@cuda//cuda:cuda_headers",
        "@cuda//curand:headers",
    ],
    alwayslink = True,
)

cc_test(
    name = "attributes_test",
    size = "small",
    srcs = ["attribute_test.cc"],
    deps = [
        ":attribute_cuda",
        ":attribute_header_only",
        "@cuda//cudart",
    ],
)

host_features_test(
    name = "host_features_test",
    target_under_test = ":attribute_cuda__cuda_host_0",
)

device_features_test(
    name = "device_features_test",
    target_under_test = ":attribute_cuda__cuda_dev_0",
)

# This compiled dependency belongs to host linking, never to the fatbinary.
cc_library(
    name = "attribute_dependency",
    testonly = True,
    srcs = ["attribute_dependency.cc"],
)

fatbinary_inputs_test(
    name = "fatbinary_inputs_test",
    target_under_test = ":attribute_cuda__fatbin_0",
)

device_policy_test(
    name = "device_policy_test",
    target_under_test = ":attribute_cuda__cuda_dev_0",
)
