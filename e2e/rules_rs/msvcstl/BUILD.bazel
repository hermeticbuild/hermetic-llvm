load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")

platform(
    name = "windows_x86_64_msvcstl",
    constraint_values = ["@llvm//constraints/cxxstdlib:msvcstl"],
    parents = ["@rules_rs//rs/platforms:x86_64-pc-windows-msvc"],
)

rust_binary(
    name = "main",
    srcs = ["main.rs"],
    experimental_use_cc_common_link = 1,
    link_deps = ["native"],
    tags = ["manual"],
    deps = ["@crates//:libc"],
)

cc_library(
    name = "native",
    # The Rust standard library uses NT APIs when linked through cc_common.link.
    linkopts = [
        # cc_common.link does not forward libc's Rust #[link] declaration.
        "legacy_stdio_definitions.lib",
        "ntdll.lib",
    ],
    deps = ["@llvm//tests/cxxstdlib_settings:msvcstl_probe"],
)
