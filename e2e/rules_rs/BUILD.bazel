load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rs//rs:rules_rust_bindgen.bzl", "rust_bindgen")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//:rust_binary_cross_build_test_suite.bzl", "rust_binary_cross_build_test_suite")

package(default_visibility = ["//visibility:public"])

_CROSS_COMPILE_PLATFORMS = {
    "@rules_rs//rs/platforms:aarch64-unknown-linux-gnu": "aarch64",
    "@rules_rs//rs/platforms:aarch64-apple-darwin": "arm64",
    "@rules_rs//rs/platforms:aarch64-pc-windows-gnullvm": "aarch64",
    "@rules_rs//rs/platforms:x86_64-unknown-linux-gnu": "x86-64",
    "@rules_rs//rs/platforms:x86_64-apple-darwin": "x86_64",
    "@rules_rs//rs/platforms:x86_64-pc-windows-gnullvm": "x86-64",
}

platform(
    name = "host_linux_gnu",
    constraint_values = [
        "@llvm//constraints/libc:gnu.2.28",
    ],
    parents = ["@platforms//host"],
)

platform(
    name = "host_windows_gnullvm",
    constraint_values = [
        "@rules_rs//rs/platforms/constraints:windows_gnullvm",
    ],
    parents = ["@platforms//host"],
)

filegroup(
    name = "proc_macros",
    srcs = ["@crates//:serde_derive"],
)

cc_library(
    name = "bindgen_stddef_headers",
    hdrs = ["bindgen_stddef.h"],
)

rust_bindgen(
    name = "bindgen_stddef",
    bindgen_flags = ["--allowlist-type=bindgen_stddef_probe"],
    cc_lib = "bindgen_stddef_headers",
    header = "bindgen_stddef.h",
)

[
    platform_transition_filegroup(
        name = "bindgen_stddef_" + platform.split(":")[-1],
        srcs = ["bindgen_stddef"],
        target_platform = platform,
    )
    for platform in _CROSS_COMPILE_PLATFORMS
]

[
    sh_test(
        name = "test_bindgen_stddef_" + platform.split(":")[-1],
        srcs = ["test_bindgen.sh"],
        args = ["$(rootpath :bindgen_stddef_" + platform.split(":")[-1] + ")"],
        data = ["bindgen_stddef_" + platform.split(":")[-1]],
    )
    for platform in _CROSS_COMPILE_PLATFORMS
]

rust_binary_cross_build_test_suite(
    name = "hello_world",
    srcs = ["src/main.rs"],
    platforms = _CROSS_COMPILE_PLATFORMS,
    deps = [
        ":linkstamp_dep",
        "@crates//:lz4-sys",
        "@crates//:mimalloc",
    ],
)

cc_library(
    name = "linkstamp_dep",
    linkstamp = "src/linkstamp.cc",
)
