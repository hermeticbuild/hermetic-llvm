import %workspace%/../../.bazelrc

common --config=cc
common --process_headers_in_dependencies
common --features=layering_check

# C++ actions don't support path mapping unless opted in.
common:cpp_path_mapping --modify_execution_info=CppModuleMap=+supports-path-mapping,CppArchive=+supports-path-mapping,CppCompile=+supports-path-mapping

# Coverage needs Bazel 9
coverage --experimental_use_llvm_covmap
coverage --experimental_generate_llvm_lcov
coverage --combined_report=lcov
