load("@bazel_features//:features.bzl", "bazel_features")
load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@llvm//3rd_party/gcc:version.bzl", "DEFAULT_GCC_VERSION", "libstdcxx_constraint_value")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load(":search.bzl", "search_output")

package(default_visibility = ["//:__pkg__"])

# These sources compile with the configured C/C++ toolchain. Their wrappers use
# include_next to reach the real builtin, libc, C++ library, and Windows SDK.
cc_library(
    name = "precedence",
    srcs = [
        "precedence.c",
        "precedence_cxx.cc",
    ],
    hdrs = [
        "include/stddef.h",
        "include/stdlib.h",
        "include/vector",
        "include/windows.h",
    ],
    features = ["system_include_paths"],
    includes = ["include"],
)

# libc++'s C++ wrappers diagnose when the C library header is found before
# their corresponding libc++ C wrapper.
cc_library(
    name = "libcxx_c_wrappers",
    srcs = [
        "libcxx_c_headers.cc",
        "libcxx_cmath.cc",
        "libcxx_cstdlib.cc",
    ],
)

sh_binary(
    name = "search_capture",
    srcs = ["search_capture.sh"],
    tags = ["manual"],
)

[
    cc_library(
        name = "search_" + language,
        srcs = ["search_" + language + extension],
        hdrs = ["include/stddef.h"],
        features = ["system_include_paths"],
        includes = ["include"],
        tags = ["manual"],
    )
    for language, extension in [
        ("c", ".c"),
        ("cxx", ".cc"),
    ]
]

[
    search_output(
        name = "search_output_" + language,
        tags = ["manual"],
        target = ":search_" + language,
    )
    for language in [
        "c",
        "cxx",
    ]
]

cc_library(
    name = "search_cuda_host",
    srcs = ["search_cxx.cc"],
    hdrs = ["include/stddef.h"],
    copts = [
        "-x",
        "cuda",
        "-nocudainc",
        "-nocudalib",
        "--cuda-host-only",
    ],
    features = ["system_include_paths"],
    includes = ["include"],
    tags = ["manual"],
)

search_output(
    name = "search_output_cuda_host",
    tags = ["manual"],
    target = ":search_cuda_host",
)

search_output(
    name = "search_output_external",
    tags = ["manual"],
    target = "@external_include_paths_test//:builtin_header_precedence",
)

platform_transition_filegroup(
    name = "search_output_cuda_host_linux_x86_64",
    srcs = [":search_output_cuda_host"],
    tags = ["manual"],
    target_platform = "@llvm//platforms:linux_x86_64",
)

_PLATFORMS = [
    "linux_" + cpu
    for cpu in [
        "x86_64",
        "aarch64",
        "armv7",
        "riscv64",
        "s390x",
    ]
] + [
    "windows_x86_64",
    "windows_aarch64",
    "windows_x86_64_msvc",
    "windows_aarch64_msvc",
    "macos_x86_64",
    "macos_aarch64",
]

[
    platform_transition_filegroup(
        name = "precedence_" + platform,
        srcs = [":precedence"],
        tags = ["manual"],
        target_platform = "@llvm//platforms:" + platform,
    )
    for platform in _PLATFORMS
]

filegroup(
    name = "all_precedence",
    srcs = [":precedence_" + platform for platform in _PLATFORMS],
    tags = ["manual"],
)

[
    platform_transition_filegroup(
        name = "libcxx_c_wrappers_" + platform,
        srcs = [":libcxx_c_wrappers"],
        tags = ["manual"],
        target_platform = "@llvm//platforms:" + platform,
    )
    for platform in _PLATFORMS
]

filegroup(
    name = "all_libcxx_c_wrappers",
    srcs = [":libcxx_c_wrappers_" + platform for platform in _PLATFORMS],
    tags = ["manual"],
)

# An external include directory must precede clang-cl's resource headers.
_MSVC_PLATFORMS = [
    "windows_x86_64_msvc",
    "windows_aarch64_msvc",
]

[
    platform_transition_filegroup(
        name = "external_builtin_precedence_" + platform,
        srcs = ["@external_include_paths_test//:builtin_header_precedence"],
        tags = ["manual"],
        target_platform = "@llvm//platforms:" + platform,
    )
    for platform in _MSVC_PLATFORMS
]

filegroup(
    name = "all_external_builtin_precedence",
    srcs = [":external_builtin_precedence_" + platform for platform in _MSVC_PLATFORMS],
    tags = ["manual"],
)

platform_transition_filegroup(
    name = "search_output_external_windows_x86_64_msvc",
    srcs = [":search_output_external"],
    tags = ["manual"],
    target_platform = "@llvm//platforms:windows_x86_64_msvc",
)

diff_test(
    name = "search_external_windows_x86_64_msvc_test",
    file1 = ":search_output_external_windows_x86_64_msvc",
    file2 = "golden/msvc_external_c" + ("" if bazel_features.cc.supports_starlarkified_toolchains else "_bazel8") + ".txt",
    tags = ["manual"],
)

# These variants have distinct C++ search roots.
platform(
    name = "windows_x86_64_msvcstl",
    constraint_values = ["@llvm//constraints/cxxstdlib:msvcstl"],
    parents = ["@llvm//platforms:windows_x86_64_msvc"],
)

platform(
    name = "linux_x86_64_libstdcxx",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@llvm//constraints/libc:gnu.2.28",
        "@llvm//constraints/cxxstdlib:" + libstdcxx_constraint_value(DEFAULT_GCC_VERSION),
    ],
)

# One representative per driver behavior and configured header-root set.
# BPF and WebAssembly use different Clang toolchains despite sharing a golden.
_SEARCH_CASES = [
    ("linux_x86_64", "@llvm//platforms:linux_x86_64", "gnu"),
    ("windows_x86_64", "@llvm//platforms:windows_x86_64", "mingw"),
    ("windows_x86_64_msvc", "@llvm//platforms:windows_x86_64_msvc", "msvc"),
    ("macos_x86_64", "@llvm//platforms:macos_x86_64", "macos"),
    ("none_bpfel", "@llvm//platforms:none_bpfel", "none"),
    ("none_wasm32", "@llvm//platforms:none_wasm32", "none"),
    ("windows_x86_64_msvcstl", ":windows_x86_64_msvcstl", "msvcstl"),
    ("linux_x86_64_libstdcxx", ":linux_x86_64_libstdcxx", "libstdcxx"),
]

# Musl's C-before-builtin order is intentional. Its current C paths precede
# target includes, so these desired-order tests stay manual until that is fixed.
_MUSL_SEARCH_CASES = [
    ("linux_x86_64_musl", "@llvm//platforms:linux_x86_64_musl", "musl"),
]

_BAZEL8_SEARCH_FAMILIES = [
    "gnu",
    "macos",
    "mingw",
    "msvc",
    "musl",
]

[
    platform_transition_filegroup(
        name = "search_output_" + language + "_" + name,
        srcs = [":search_output_" + language],
        tags = ["manual"],
        target_platform = target_platform,
    )
    for name, target_platform, _ in _SEARCH_CASES + _MUSL_SEARCH_CASES
    for language in [
        "c",
        "cxx",
    ]
]

[
    diff_test(
        name = "search_" + language + "_" + name + "_test",
        failure_message = "Clang's effective " + language + " header search order changed for " + name,
        file1 = ":search_output_" + language + "_" + name,
        file2 = select({
            "@llvm//config:macos_libcxx_headers_llvm": "golden/macos_cxx_llvm" + ("" if bazel_features.cc.supports_starlarkified_toolchains else "_bazel8") + ".txt",
            "//conditions:default": "golden/macos_cxx" + ("" if bazel_features.cc.supports_starlarkified_toolchains else "_bazel8") + ".txt",
        }) if family == "macos" and language == "cxx" else "golden/" + family + "_" + language + ("_bazel8" if family in _BAZEL8_SEARCH_FAMILIES and not bazel_features.cc.supports_starlarkified_toolchains else "") + ".txt",
        tags = ["manual"],
    )
    for name, _, family in _SEARCH_CASES + _MUSL_SEARCH_CASES
    for language in [
        "c",
        "cxx",
    ]
]

diff_test(
    name = "search_cuda_host_linux_x86_64_test",
    file1 = ":search_output_cuda_host_linux_x86_64",
    file2 = "golden/gnu_cuda_host" + ("" if bazel_features.cc.supports_starlarkified_toolchains else "_bazel8") + ".txt",
    tags = ["manual"],
)

test_suite(
    name = "search_tests",
    tags = ["manual"],
    tests = [
        ":search_" + language + "_" + name + "_test"
        for name, _, _ in _SEARCH_CASES
        for language in [
            "c",
            "cxx",
        ]
    ] + [
        ":search_cuda_host_linux_x86_64_test",
        ":search_external_windows_x86_64_msvc_test",
    ],
)

test_suite(
    name = "musl_search_tests",
    tags = ["manual"],
    tests = [
        ":search_" + language + "_" + name + "_test"
        for name, _, _ in _MUSL_SEARCH_CASES
        for language in [
            "c",
            "cxx",
        ]
    ],
)
