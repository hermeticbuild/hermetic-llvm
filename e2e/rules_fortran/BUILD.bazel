load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_fortran//fortran:defs.bzl", "fortran_library", "fortran_test")
load("@rules_fortran//fortran:toolchain.bzl", "fortran_toolchain")

platform(
    name = "linux_amd64_musl_remote",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@llvm//constraints/libc:musl",
    ],
    exec_properties = {
        "container-image": "docker://ubuntu:22.04",
        "Arch": "amd64",
        "OSFamily": "Linux",
    },
)

fortran_toolchain(
    name = "flang_toolchain_impl",
    archiver = "@flang_prebuilt//:bin/llvm-ar",
    compiler = "@flang_prebuilt//:bin/flang",
    linker = "@flang_prebuilt//:bin/flang",
    runtime_libraries = ["@flang_prebuilt//:runtime_libraries"],
    tool_deps = ["@flang_prebuilt//:all_files"],
)

toolchain(
    name = "flang_toolchain",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@llvm//constraints/libc:musl",
    ],
    toolchain = ":flang_toolchain_impl",
    toolchain_type = "@rules_fortran//fortran:toolchain_type",
)

fortran_test(
    name = "fortran_main",
    srcs = ["smoke.f90"],
)

fortran_library(
    name = "fortran_add",
    srcs = ["fortran_add.f90"],
)

cc_test(
    name = "c_main",
    srcs = ["c_main.c"],
    features = ["fully_static_link"],
    linkstatic = True,
    deps = [":fortran_add"],
)
