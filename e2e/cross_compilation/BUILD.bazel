load("@bazel_lib//lib:transitions.bzl", "platform_transition_binary")
load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@llvm//constraints/libc:libc_versions.bzl", "LIBCS")
load("@llvm//platforms/distros/linux:constraints.bzl", "UBUNTU_20_04_CONSTRAINTS")
load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")
load("@platforms_contrib//cpu/x86_64:x86_64.bzl", "x86_64_level_constraints")
load("@platforms_contrib//os/linux/libc/glibc:glibc.bzl", "glibc_version_constraints")
load("@platforms_contrib//os/linux/libc/musl:musl.bzl", "musl_version_constraints")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_qemu//qemu:qemu_binary.bzl", "qemu_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

string_flag(
    name = "test_glibc_versions",
    build_setting_default = "all",
    values = [
        "all",
        "none",
    ],
)

config_setting(
    name = "no_test_glibc_versions",
    flag_values = {
        ":test_glibc_versions": "none",
    },
)

cc_library(
    name = "add",
    srcs = ["add.c"],
    hdrs = ["add.h"],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "main",
    srcs = ["test.cc"],
    deps = [":add"],
)

cc_binary(
    name = "hello",
    srcs = ["hello.c"],
)

cc_test(
    name = "hello_test",
    srcs = ["hello.c"],
    exec_compatible_with = HOST_CONSTRAINTS,
    # remote-exec tests can't run without forcing the target platform to match
    # the remote exec platform.
    tags = ["no-remote"],
)

platform(
    name = "ubuntu_20_04_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ] + UBUNTU_20_04_CONSTRAINTS,
)

cc_binary(
    name = "linux_kernel_version_test",
    srcs = ["linux_kernel_version_test.c"],
    tags = ["manual"],
)

platform_transition_binary(
    name = "linux_kernel_version_5_4_test",
    binary = ":linux_kernel_version_test",
    target_platform = ":ubuntu_20_04_amd64",
)

# Platforms that only describe what's available on them via @platforms_contrib constraints.
platform(
    name = "linux_x86_64_v3_glibc_2_35",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ] + glibc_version_constraints("2.35") + x86_64_level_constraints("v3"),
    flags = ["--@llvm//config:x86_64_tune_cpu=znver4"],
)

platform(
    name = "linux_aarch64_musl_1_2",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ] + musl_version_constraints("1.2"),
)

platform(
    name = "linux_x86_64_glibc_2_35_and_musl_1_2",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ] + glibc_version_constraints("2.35") + musl_version_constraints("1.2"),
    flags = ["--@llvm//config:preferred_libc=musl"],
)

# TODO(cerisier): should the toolchain provide its own list ?
PLATFORMS = [
    "@llvm//platforms:linux_x86_64",
    "@llvm//platforms:linux_aarch64",
    "@llvm//platforms:linux_riscv64",
    "@llvm//platforms:linux_s390x",
    "@llvm//platforms:linux_armv7",
    "@llvm//platforms:macos_x86_64",
    "@llvm//platforms:macos_aarch64",
    "@llvm//platforms:windows_amd64",
    "@llvm//platforms:windows_arm64",
    "@llvm//platforms:windows_x86_64_msvc",
    "@llvm//platforms:windows_aarch64_msvc",
] + [
    "@llvm//platforms:linux_x86_64_{}".format(libc)
    for libc in LIBCS
] + [
    "@llvm//platforms:linux_aarch64_{}".format(libc)
    for libc in LIBCS
] + [
    "@llvm//platforms:linux_s390x_{}".format(libc)
    for libc in LIBCS
] + [
    "@llvm//platforms:linux_armv7_{}".format(libc)
    for libc in LIBCS
] + [
    # RISC-V needs special LIBC treatment because of the kernel-glibc association we do.
    # Builtins requires kernel headers >= 5.10 which we hardcode to be 2.33+
    "@llvm//platforms:linux_riscv64_musl",
    ":linux_x86_64_v3_glibc_2_35",
    ":linux_aarch64_musl_1_2",
    ":linux_x86_64_glibc_2_35_and_musl_1_2",
]

[
    platform_transition_binary(
        name = "main_" + platform.split(":")[-1],
        binary = ":main",
        tags = ["manual"] if platform.endswith("_msvc") else [],
        target_compatible_with = select({
            ":no_test_glibc_versions": ["@platforms//:incompatible"] if "gnu" in platform else [],
            "//conditions:default": [],
        }),
        target_platform = platform,
    )
    for platform in PLATFORMS
]

platform(
    name = "linux_armv7_musl_vfpv4_d16",
    constraint_values = [
        "@platforms//cpu:armv7",
        "@platforms//os:linux",
        "@llvm//constraints/libc:musl",
        "@llvm//constraints/fpu:vfpv4-d16",
    ],
)

QEMU_MUSL_PLATFORMS = {
    "linux_aarch64_musl_1_2": {
        "target_platform": ":linux_aarch64_musl_1_2",
    },
    "linux_x86_64_glibc_2_35_and_musl_1_2": {
        "target_platform": ":linux_x86_64_glibc_2_35_and_musl_1_2",
    },
    "linux_riscv64_musl": {
        "target_platform": "@llvm//platforms:linux_riscv64_musl",
    },
    "linux_s390x_musl": {
        "target_platform": "@llvm//platforms:linux_s390x_musl",
    },
    "linux_armv7_musl": {
        "target_platform": "@llvm//platforms:linux_armv7_musl",
    },
    # Force qemu to a non-default ARM core that matches the -mfpu=vfpv4-d16
    # codepath, so the test actually exercises vfpv4-d16 instructions instead
    # of falling through to NEON.
    "linux_armv7_musl_vfpv4_d16": {
        "target_platform": ":linux_armv7_musl_vfpv4_d16",
        "qemu_cpu": "cortex-a7,neon=off,vfp-d32=off",
    },
}

[
    qemu_binary(
        name = "hello_" + platform,
        binary = ":hello",
        tags = ["manual"],
        target_platform = cfg["target_platform"],
    )
    for platform, cfg in QEMU_MUSL_PLATFORMS.items()
]

[
    sh_test(
        name = "hello_{}_qemu_test".format(platform),
        srcs = ["test_hello_qemu.sh"],
        data = [":hello_{}".format(platform)],
        env = {
            "BINARY": "$(rootpath :hello_{})".format(platform),
            "EXPECTED_OUTPUT": "Hello, World corentin!",
        } | ({"QEMU_CPU": cfg["qemu_cpu"]} if "qemu_cpu" in cfg else {}),
        exec_compatible_with = [
            "@platforms//os:linux",
        ],
        target_compatible_with = [
            "@platforms//os:linux",
        ],
    )
    for platform, cfg in QEMU_MUSL_PLATFORMS.items()
]
