load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_platform//platform_data:defs.bzl", "platform_data")
load(":uefi_qemu_test.bzl", "qemu_system_target", "uefi_qemu_test")

cc_binary(
    name = "uefi_app",
    srcs = ["uefi.c"],
    tags = ["manual"],
    deps = [":uefi_support"],
)

# Exercise GNU C++ compilation and static archive linkage without a hosted CRT.
cc_library(
    name = "uefi_support",
    srcs = ["uefi_support.cc"],
    tags = ["manual"],
)

platform_data(
    name = "uefi_x86_64_app",
    platform = "@llvm//platforms:uefi_x86_64",
    target = ":uefi_app",
)

# Compile/link coverage for the second supported UEFI architecture.
platform_data(
    name = "uefi_aarch64_app",
    platform = "@llvm//platforms:uefi_aarch64",
    target = ":uefi_app",
)

qemu_system_target(
    name = "qemu_system_target",
    build_setting_default = "x86_64",
    visibility = ["//visibility:public"],
)

config_setting(
    name = "qemu_system_x86_64",
    flag_values = {
        ":qemu_system_target": "x86_64",
    },
    visibility = ["//visibility:public"],
)

uefi_qemu_test(
    name = "uefi_x86_64_test",
    size = "medium",
    application = ":uefi_x86_64_app",
    # Match the cross-compilation QEMU tests: execute on the Linux runner
    # itself, where the qemu-system prebuilt and edk2 firmware run proven,
    # instead of scheduling the test on the remote executor.
    exec_compatible_with = ["@platforms//os:linux"],
    target_compatible_with = ["@platforms//os:linux"],
)
