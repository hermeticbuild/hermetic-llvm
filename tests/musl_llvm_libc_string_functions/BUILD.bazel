load("@bazel_lib//lib:transitions.bzl", "platform_transition_binary")
load("@llvm//:defs.bzl", "exec_test")
load("@llvm//toolchain:selects.bzl", "platform_llvm_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":defs.bzl", "llvm_libc_string_functions_cc_binary")

alias(
    name = "llvm-nm",
    actual = platform_llvm_binary("llvm-nm"),
)

llvm_libc_string_functions_cc_binary(
    name = "string_functions_test_binary",
    srcs = ["string_functions_test.c"],
    # Make sure that every call reaches libc.
    copts = ["-fno-builtin"],
    tags = ["manual"],
)

platform(
    name = "host_linux_musl",
    constraint_values = [
        "//constraints/libc:musl",
    ],
    parents = ["@platforms//host"],
)

platform_transition_binary(
    name = "string_functions_test_binary_host",
    binary = ":string_functions_test_binary",
    target_compatible_with = ["@platforms//os:linux"],
    target_platform = ":host_linux_musl",
)

# Runs the static musl binary on the Linux host, which doesn't need an
# execution platform with the musl constraint.
sh_test(
    name = "string_functions_test",
    srcs = ["run_test_binary.sh"],
    args = ["$(rootpath :string_functions_test_binary_host)"],
    data = [":string_functions_test_binary_host"],
    target_compatible_with = ["@platforms//os:linux"],
)

[
    platform_transition_binary(
        name = "string_functions_test_binary_" + cpu,
        binary = ":string_functions_test_binary",
        target_platform = "//platforms:linux_{}_musl".format(cpu),
    )
    for cpu in [
        "x86_64",
        "aarch64",
    ]
]

[
    exec_test(
        sh_test,
        name = "llvm_libc_symbols_{}_test".format(cpu),
        srcs = ["verify_llvm_libc_symbols.sh"],
        args = [
            "$(rootpath :llvm-nm)",
            "$(rootpath :string_functions_test_binary_{})".format(cpu),
        ],
        data = [
            ":llvm-nm",
            ":string_functions_test_binary_" + cpu,
        ],
    )
    for cpu in [
        "x86_64",
        "aarch64",
    ]
]
