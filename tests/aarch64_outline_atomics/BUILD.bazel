load("@bazel_lib//lib:copy_file.bzl", "copy_file")
load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

OSES = ("linux", "macos", "windows")

[
    platform_transition_filegroup(
        name = "builtins_" + os,
        srcs = ["@llvm-project//compiler-rt:clang_rt.builtins.static"],
        target_platform = "@llvm//platforms:{}_aarch64".format(os),
    )
    for os in OSES
]

# The three archives share a runfiles path, so give each its own name.
[
    copy_file(
        name = "copy_builtins_" + os,
        src = ":builtins_" + os,
        out = "builtins_{}.a".format(os),
    )
    for os in OSES
]

# Only Linux-like targets call the __aarch64_* outline atomic helpers.
sh_test(
    name = "outline_atomics_test",
    srcs = ["outline_atomics_test.sh"],
    args = ["$(rootpath builtins_{}.a)".format(os) for os in OSES],
    data = ["builtins_{}.a".format(os) for os in OSES],
)
