load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//:apify.bzl", "apify_binary")
load("//:defs.bzl", "exec_test")
load("//platforms:common.bzl", "COSMO_TARGET_CPUS")

SMOKE_SUFFIXES = [
    "",
    "_source",
]

cc_library(
    name = "c_tls",
    srcs = ["c_tls.c"],
    target_compatible_with = ["//constraints/libc:cosmo"],
)

cc_binary(
    name = "smoke_elf",
    srcs = ["smoke.cc"],
    target_compatible_with = ["//constraints/libc:cosmo"],
    deps = [":c_tls"],
)

[
    platform_transition_filegroup(
        name = "smoke" + suffix + "_" + cpu,
        srcs = [":smoke_elf"],
        tags = ["manual"] if suffix else [],
        target_platform = "//platforms:cosmo_" + cpu + suffix,
    )
    for suffix in SMOKE_SUFFIXES
    for cpu in COSMO_TARGET_CPUS
]

[
    apify_binary(
        name = "smoke" + suffix,
        aarch64 = ":smoke" + suffix + "_aarch64",
        apelink = "//runtimes/cosmo:apelink" if suffix else None,
        tags = ["manual"],
        x86_64 = ":smoke" + suffix + "_x86_64",
    )
    for suffix in SMOKE_SUFFIXES
]

[
    exec_test(
        name = "smoke" + suffix + "_test",
        size = "small",
        srcs = ["smoke_test.sh"],
        args = ["smoke" + suffix + ".com"],
        data = [":smoke" + suffix],
        rule = sh_test,
        tags = ["manual"] if suffix else [],
        target_compatible_with = select({
            "@platforms//os:linux": [],
            "@platforms//os:macos": [],
            "//conditions:default": ["@platforms//:incompatible"],
        }),
    )
    for suffix in SMOKE_SUFFIXES
]
