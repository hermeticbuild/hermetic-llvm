load("@bazel_lib//:bzl_library.bzl", "bzl_library")
load(":declare_config_settings.bzl", "declare_config_settings")

declare_config_settings()

config_setting(
    name = "windows_crt_msvcrt",
    constraint_values = [
        "@platforms//os:windows",
        "//constraints/windows/crt:msvcrt",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "windows_crt_ucrt",
    constraint_values = [
        "@platforms//os:windows",
        "//constraints/windows/crt:ucrt",
    ],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "declare_config_settings",
    srcs = ["declare_config_settings.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "//constraints/libc:libc_versions",
        "//constraints/windows/abi:abis",
        "//platforms:common",
        "//toolchain:bootstrap_stages",
        "@bazel_skylib//lib:selects",
    ],
)
